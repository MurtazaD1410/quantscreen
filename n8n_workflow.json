{
  "name": "QuantScreen Pipeline Refresh",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message.text }}",
              "operation": "contains",
              "value2": "/refresh"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000002",
      "name": "Is /refresh command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "command": "cd /mnt/main/apps/quantscreen && git pull && docker compose restart"
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000003",
      "name": "Git Pull & Restart App",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [680, 180]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "✅ QuantScreen restarted with latest data.\n\n📅 {{ $now.toFormat('dd MMM yyyy HH:mm') }}",
        "additionalFields": {}
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000004",
      "name": "Telegram Done",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [900, 180],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0000-0000-0000-000000000005",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [240, 520]
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "🚨 QuantScreen workflow error — {{ $json.execution.error.message }}",
        "additionalFields": {}
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000006",
      "name": "Telegram Error",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [460, 520],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [{"node": "Is /refresh command?", "type": "main", "index": 0}]
      ]
    },
    "Is /refresh command?": {
      "main": [
        [{"node": "Git Pull & Restart App", "type": "main", "index": 0}],
        []
      ]
    },
    "Git Pull & Restart App": {
      "main": [
        [{"node": "Telegram Done", "type": "main", "index": 0}]
      ]
    },
    "On Workflow Error": {
      "main": [
        [{"node": "Telegram Error", "type": "main", "index": 0}]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "quantscreen-pipeline-refresh",
  "meta": {
    "instanceId": "quantscreen"
  }
}
