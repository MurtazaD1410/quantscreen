{
  "name": "QuantScreen Pipeline Refresh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7,13 * * *"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000001",
      "name": "Schedule (7AM + 1PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "command": "cd /mnt/tank/quantscreen && git pull && docker compose up --build -d"
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000002",
      "name": "Git Pull & Rebuild",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://TRUENAS_IP:8502/pipeline/trigger",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000003",
      "name": "Trigger Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "started"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000004",
      "name": "Triggered OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "✅ QuantScreen pipeline triggered — NSE All refresh started at {{ $now.toISO() }}",
        "additionalFields": {}
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000005",
      "name": "Telegram Success",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1120, 180],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "⏳ QuantScreen pipeline already running since {{ $json.started_at }} — skipping trigger",
        "additionalFields": {}
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000006",
      "name": "Telegram Already Running",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1120, 420],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0000-0000-0000-000000000007",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [240, 560]
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "🚨 QuantScreen workflow error — {{ $json.execution.error.message }}",
        "additionalFields": {}
      },
      "id": "a1b2c3d4-0000-0000-0000-000000000008",
      "name": "Telegram Error",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [460, 560],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Schedule (7AM + 1PM)": {
      "main": [
        [{"node": "Git Pull & Rebuild", "type": "main", "index": 0}]
      ]
    },
    "Git Pull & Rebuild": {
      "main": [
        [{"node": "Trigger Pipeline", "type": "main", "index": 0}]
      ]
    },
    "Trigger Pipeline": {
      "main": [
        [{"node": "Triggered OK?", "type": "main", "index": 0}]
      ]
    },
    "Triggered OK?": {
      "main": [
        [{"node": "Telegram Success", "type": "main", "index": 0}],
        [{"node": "Telegram Already Running", "type": "main", "index": 0}]
      ]
    },
    "On Workflow Error": {
      "main": [
        [{"node": "Telegram Error", "type": "main", "index": 0}]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "quantscreen-pipeline-refresh",
  "meta": {
    "instanceId": "quantscreen"
  }
}
