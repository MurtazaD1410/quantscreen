{"info": {"address1": "Village Meda - Adraj", "address2": "Taluka Kadi", "city": "Mehsana", "zip": "384441", "country": "India", "phone": "91 27 6428 5502", "fax": "91 79 2644 5105", "website": "https://www.hester.in", "industry": "Drug Manufacturers - Specialty & Generic", "industryKey": "drug-manufacturers-specialty-generic", "industryDisp": "Drug Manufacturers - Specialty & Generic", "sector": "Healthcare", "sectorKey": "healthcare", "sectorDisp": "Healthcare", "longBusinessSummary": "Hester Biosciences Limited manufactures and trades in veterinary vaccines and animal health products in India and internationally. It operates through the Poultry Healthcare and Animal Healthcare segments. The company provides poultry vaccines for newcastle disease, infectious bronchitis, infectious bursal, fowl pox, marek's disease, infectious coryza, fowl cholera, inclusion body hepatitis, fowl typhoid, and avian encephalomyelitis. It also offers vaccines for peste des petits ruminants, goat pox, brucella abortus, lumpy skin disease, contagious bovine pleuropneumonia, and contagious caprine pleuropneumonia for cattle, buffalo, sheep, and goats; and diagnostic services. In addition, the company provides animal healthcare products, such as biosecurity solutions, therapeutic treatment, herbal supplements, homeopathic remedies, and feed supplements. Further, it offers various pet care products, including gut health solutions, NSAIDs, joint care formulations, parasiticides, grooming aids, and anti-infective formulations; and healthcare products, such as immune boosters, gut health enhancers, vitamins, minerals and specialty feed supplements, and various formulations for critical needs comprising disease prevention, growth, and nutritional balance. Additionally, the company provides sero-profiling kits, diagnostic labs for poultry flocks, and mastitis control programs for cattle; and manufactures and trades in goods. Hester Biosciences Limited was incorporated in 1987 and is headquartered in Mehsana, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Rajiv Dinesh Gandhi B.Com", "age": 63, "title": "Executive CEO, MD & Executive Director", "yearBorn": 1962, "fiscalYear": 2025, "totalPay": 40070000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Priya Rajiv Gandhi", "age": 32, "title": "Executive Director", "yearBorn": 1993, "fiscalYear": 2025, "totalPay": 8130000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ashish Dineshbhai Desai", "age": 57, "title": "Chief Financial Officer", "yearBorn": 1968, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Vinod  Mali", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Sulochana  Shrestha", "title": "CEO of Hester Biosciences Nepal Private Limited", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Upendra K. Jani", "age": 69, "title": "Consultant", "yearBorn": 1956, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 1875.2, "open": 1910.0, "dayLow": 1884.0, "dayHigh": 1919.9, "regularMarketPreviousClose": 1875.2, "regularMarketOpen": 1910.0, "regularMarketDayLow": 1884.0, "regularMarketDayHigh": 1919.9, "dividendRate": 7.0, "dividendYield": 0.37, "exDividendDate": 1754438400, "payoutRatio": 0.103599995, "fiveYearAvgDividendYield": 0.43, "beta": 0.428, "trailingPE": 28.212116, "volume": 4293, "regularMarketVolume": 4293, "averageVolume": 10074, "averageVolume10days": 31488, "averageDailyVolume10Day": 31488, "bid": 1901.1, "ask": 1904.6, "nonDilutedMarketCap": 15958878740, "fiftyTwoWeekLow": 1239.3, "fiftyTwoWeekHigh": 2350.0, "allTimeHigh": 3379.0, "allTimeLow": 363.0, "fiftyDayAverage": 1537.626, "twoHundredDayAverage": 1662.4545, "trailingAnnualDividen