{"info": {"address1": "Centrum House", "address2": "Level 9 C.S.T. Road Vidyanagari Marg Kalina, Santacruz (East)", "city": "Mumbai", "zip": "400098", "country": "India", "phone": "91 22 4215 9000", "fax": "91 22 4215 9940", "website": "https://www.centrum.co.in", "industry": "Financial Conglomerates", "industryKey": "financial-conglomerates", "industryDisp": "Financial Conglomerates", "sector": "Financial Services", "sectorKey": "financial-services", "sectorDisp": "Financial Services", "longBusinessSummary": "Centrum Capital Limited, together with its subsidiaries, provides various financial services for institutions and individuals in India and internationally. It operates through Banking Business; Institutional Business; Wealth Management & Distribution; and Housing Finance Business segments. The company offers investment banking services, including equity initial public offerings (IPO), follow-on public offerings and rights issues, pre-IPO placements, qualified institutional placements, American depository receipts, global depository receipts, alternative investment markets, convertible issuances, buybacks and delisting, open offers, and valuation advisory services; working capital, project finance, term/corporate loans, and external commercial borrowings/foreign currency loans; and mergers and acquisitions, structured finance advisory, and private equity advisory services, as well as infrastructure advisory services. It also provides home and non-home loans; distribution services, tax and financial planning, family legacy and leadership, philanthropy, trust and estate, and ancillary services; corporate treasury services; stock broking services; general, travel, health, and life insurance services; private credit and venture debt funding services; and portfolio management and wealth management and retail broking services. In addition, the company offers institutional equities and research services, as well as trades in bonds. Further, it offers MSME loans and micro finance services. Centrum Capital Limited was incorporated in 1977 and is based in Mumbai, India.", "fullTimeEmployees": 6200, "companyOfficers": [{"maxAge": 1, "name": "Mr. Jaspal Singh Bindra", "age": 65, "title": "Executive Chairman", "yearBorn": 1960, "fiscalYear": 2025, "totalPay": 65229600, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Chandir Gobind Gidwani", "age": 60, "title": "Founder & Chairman Emeritus", "yearBorn": 1965, "fiscalYear": 2025, "totalPay": 600000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Shailendra Kishor Apte", "age": 55, "title": "Chief Financial Officer", "yearBorn": 1970, "fiscalYear": 2025, "totalPay": 6032489, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajendra  Naik", "title": "Managing Director of Investment Banking", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Balakrishna  Kumar", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Deepa  Poncha", "age": 62, "title": "Director of Human Resources", "yearBorn": 1963, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sandeep  Upadhyay", "title": "MD & CEO of Centrum Infrastructure Advisory Limited", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ranjan  Ghosh", "age": 61, "title": "CEO & Managing Director of NBFC", "yearBorn": 1964, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sushen  Jhingan", "title": "Business Development & Strategic Initiatives Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 22.97, "open": 22.95, "dayLow": 22.7, "dayHigh": 23.79, "regularMarketPreviousClose": 22.97, "reg