{"info": {"address1": "Marathon Innova", "address2": "Marathon Nextgen Complex 603, B1 Wing Lower Parel West", "city": "Mumbai", "zip": "400013", "country": "India", "phone": "91 22 4049 9999", "website": "https://www.aarviencon.com", "industry": "Staffing & Employment Services", "industryKey": "staffing-employment-services", "industryDisp": "Staffing & Employment Services", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Aarvi Encon Limited, a technical manpower supply company, provides permanent and temporary manpower services in India, Malaysia, Italy, and internationally. The company offers procurement assistance and expediting; pre commissioning and commissioning services; manpower outsourcing, and deputation and technical staffing; operation and maintenance; project and engineering design; project management; CAD/drafting/3D modelling; shutdown; construction supervision; engineering services; and IT staffing and inspection services. It serves cement, engineering, infrastructure, metro, petrochemical, railway, telecom, EPC, IT, mono rail, pipeline, refinery, CGD and CNG, fertilizer, metal and minerals, oil and gas, power, and renewable energy industries. Aarvi Encon Limited was incorporated in 1987 and is headquartered in Mumbai, India.", "fullTimeEmployees": 220, "companyOfficers": [{"maxAge": 1, "name": "Mr. Virendra Dalpatram Sanghavi", "age": 83, "title": "MD & Founding Director", "yearBorn": 1942, "fiscalYear": 2025, "totalPay": 16800000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Jaydev Virendra Sanghavi", "age": 54, "title": "CFO & Executive Director", "yearBorn": 1971, "fiscalYear": 2025, "totalPay": 16800000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Leela Soban Singh Bisht", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "execu