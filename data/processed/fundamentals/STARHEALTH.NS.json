{"info": {"address1": "Acropolis", "address2": "No: 148, Dr. Radha Krishnan Salai Mylapore", "city": "Chennai", "zip": "600004", "country": "India", "phone": "91 44 4788 6666", "website": "https://www.starhealth.in", "industry": "Insurance - Life", "industryKey": "insurance-life", "industryDisp": "Insurance - Life", "sector": "Financial Services", "sectorKey": "financial-services", "sectorDisp": "Financial Services", "longBusinessSummary": "Star Health and Allied Insurance Company Limited provides health insurance products in India. It offers retail health insurance products for individuals, families, children, senior citizens, and persons with pre-existing medical conditions; group health insurance products for employer/employee and non-employer/employee groups, including small-to-medium enterprises; and personal accident and travel insurance products. The company also provides star women care insurance policy that provides surrogacy and oocyte donor covers; and star special care product that covers children diagnosed with autism and for outpatient specialized treatments. In addition, it offers star health assure insurance policy, star cancer care platinum insurance policy, senior citizens health insurance policy, and star cardiac care insurance policy \u0096 platinum, as well as star group OPD care insurance product. The company offers its products through web aggregators, digital channels, agency channels, corporate agents, brokers, point of salesperson, insurance marketing firms, and various other channels. Star Health and Allied Insurance Company was incorporated in 2005 and is based in Chennai, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Anand Shankar Roy", "age": 50, "title": "MD, CEO & Director", "yearBorn": 1975, "fiscalYear": 2025, "totalPay": 91900000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Nilesh Ashok Kambli", "age": 44, "title": "Chief Financial Officer", "yearBorn": 1981, "fiscalYear": 2025, "exercisedValue