{"info": {"address1": "D. No. 1-8-31/1", "address2": "Minister\u2019s Road Telangana", "city": "Secunderabad", "zip": "500003", "country": "India", "phone": "91 40 4488 5000", "fax": "91 40 2784 0980", "website": "https://www.kimshospitals.com", "industry": "Medical Care Facilities", "industryKey": "medical-care-facilities", "industryDisp": "Medical Care Facilities", "sector": "Healthcare", "sectorKey": "healthcare", "sectorDisp": "Healthcare", "longBusinessSummary": "Krishna Institute of Medical Sciences Limited provides medical and health care services under the KIMS Hospitals brand in India. The company offers neurology, neurosurgery, psychiatry, and neuro rehabilitation; cardiology, cardiac and vascular surgery, heart transplant, and cardio rehabilitation; and pulmonology, interventional pulmonology, thoracic surgery, and lung transplant. It also provides medical and surgical gastroenterology, hepatobiliary pancreatic surgery, liver transplant, and bariatric surgery; ear, nose, throat, and head and neck surgery; and nephrology, urology, andrology, renal transplant, gynecology, urogynecology, IVF and art, fetal medicine, and obstetrics. In addition, the company offers orthopedics, arthroscopic and spine surgery, and ortho rehabilitation; medical surgical and radiation, and BMT and hematology; ophthalmology; dermatology, cosmetology, and plastic and reconstructive surgery; and clinical infectious diseases. Further, it provides imaging and interventional radiology; paediatrics and pediatric sub specialities, and neonatology; maxillo-facial surgery; OT and day care anaesthesia and pain medicine; and pathology, microbiology, and biochemistry. Additionally, the company offers molecular biology and clinical hematology; internal medicine, general surgery, and diabetology and endocrinology; and ICU, CTICU, SICU, NICU, PICU, neuro and ECMO ICU, and post transplant ICU services. Krishna Institute of Medical Sciences Limited was incorporated in 1973 and is based in Secunderabad, India.", "companyOfficers": [{"maxAge": 1, "name": "Dr. Bhaskara Rao Bollineni", "age": 71, "title": "Founder, MD & Executive Chairman", "yearBorn": 1954, "fiscalYear": 2025, "totalPay": 45000000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Abhinay  Bollineni", "age": 37, "title": "CEO & Executive Director", "yearBorn": 1988, "fiscalYear": 2025, "totalPay": 26000000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sachin Ashok Salvi", "age": 44, "title": "Chief Financial Officer", "yearBorn": 1981, "fiscalYear": 2025, "totalPay": 15000000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Anitha  Dandamudi", "age": 56, "title": "Director of Operations & Wholetime Executive Director", "yearBorn": 1969, "fiscalYear": 2025, "totalPay": 6790000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Juttur Raghavendradas Nagajayanthi", "title": "Company Secretary, Compliance Officer & General Counsel", "fiscalYear": 2025, "totalPay": 1000000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sreenath Pocha Reddy CA, LLB", "age": 51, "title": "Cluster Head for the Karnataka cluster", "yearBorn": 1974, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Nitish  Shetty", "age": 53, "title": "CEO for KIMS Bangalore Cluster", "yearBorn": 1972, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 764.1, "open": 769.95, "dayLow": 744.05, "dayHigh": 769.95, "regularMarketPreviousClose": 764.1, "regularMarketOpen": 769.95, "regularMarketDayLow": 744.05, "regularMarketDayHigh": 769.95, "payoutRatio": 0.0, "beta": 0.134, "trailingPE": 123.849335, "forwardPE": 43.194145, "volume": 111196, "regularMarketVolume": 111196, "averageVolume": 494367, "averageVolume10days": 831395, "averageDailyVolume10Day": 83