ani", "age": 58, "title": "Director and Director of HR & EB", "yearBorn": 1967, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Anirudh Prasad Singh", "title": "Chief Financial Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sudhakararao  Papa", "age": 55, "title": "Director of Technical & Director", "yearBorn": 1970, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 29.28, "open": 29.4, "dayLow": 29.4, "dayHigh": 30.25, "regularMarketPreviousClose": 29.28, "regularMarketOpen": 29.4, "regularMarketDayLow": 29.4, "regularMarketDayHigh": 30.25, "exDividendDate": 1253145600, "payoutRatio": 0.0, "fiveYearAvgDividendYield": 2.85, "beta": 0.674, "volume": 941395, "regularMarketVolume": 941395, "averageVolume": 1898638, "averageVolume10days": 1483132, "averageDailyVolume10Day": 1483132, "bid": 29.87, "ask": 29.91, "bidSize": 0, "askSize": 0, "marketCap": 18855901184, "nonDilutedMarketCap": 18333000000, "fiftyTwoWeekLow": 21.26, "fiftyTwoWeekHigh": 58.2, "allTimeHigh": 387.9, "allTimeLow": 4.45, "priceToSalesTrailing12Months": 4.1428795, "fiftyDayAverage": 28.4746, "twoHundredDayAverage": 35.3514, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "INR", "tradeable": false, "enterpriseValue": 358200999936, "profitMargins": 0.0, "floatShares": 267450627, "sharesOutstanding": 630000000, "heldPercentInsiders": 0.56251, "heldPercentInstitutions": 0.13149, "impliedSharesOutstanding": 630000000, "bookValue": -457.082, "lastFiscalYearEnd": 1743379200, "nextFiscalYearEnd": 1774915200, "mostRecentQuarter": 1767139200, "netIncomeToCommon": -36281798656, "trailingEps": -49.32, "enterpriseToRevenue": 78.701, "enterpriseToEbitda": -134.267, "52WeekChange": -0.34305584, "SandP52WeekChange": 0.26208222, "lastDividendValue": 1.0, "lastD