{"info": {"address1": "Birla Centurion", "address2": "10th to 12th Floor Century Mills Compound Pandurang Budhkar Marg, Worli", "city": "Mumbai", "zip": "400030", "country": "India", "phone": "91 95 9400 4000", "fax": "91 22 2482 0095", "website": "https://www.myvi.in", "industry": "Telecom Services", "industryKey": "telecom-services", "industryDisp": "Telecom Services", "sector": "Communication Services", "sectorKey": "communication-services", "sectorDisp": "Communication Services", "longBusinessSummary": "Vodafone Idea Limited, together with its subsidiaries, provides mobile telecommunication services in India. The company offers voice services, such as 4G VoLTE and Voice over WIFI calling; broadband data services on 3G, 4G, and 5G platforms; content and digital products and services; value-added services, including over-the-top paid subscription, digital advertising, gaming, digital marketplace, and utility bill payment app, as well as voice and short messaging services; and long distance and internet service provider services. It also engages in renting of passive infrastructure to telecommunication service providers; outsourcing backend IT support, data centre operations, and hosting; and provision of high speed broadband internet access through cable network and high bandwidth internet broadband, and manpower services. In addition, the company trades in mobile handsets, data cards, and related accessories and services; outsources finance and accounts, human resources, supply chain management, credit and collection support, and customer support, as well as caters to the information technology (IT) needs for data consolidation. Further, it offers technology, software, hardware, VAS, application software, and contents and related products and services, which facilitate and develop access to IT enabled VAS products and services on single or multiple platforms or operating systems; and data centre related services and IT solutions, including E-SIMs activation, as well as prepaid and postpaid plans. The company was formerly known as Idea Cellular Limited and changed its name to Vodafone Idea Limited in August 2018. Vodafone Idea Limited was incorporated in 1995 and is based in Mumbai, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Abhijit  Kishore", "title": "Chief Executive Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Tejas  Mehta", "age": 48, "title": "Chief Financial Officer", "yearBorn": 1977, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Jagbir  Singh M.Sc., MBA", "age": 60, "title": "Chief Technology Officer", "yearBorn": 1965, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Pankaj  Kapdeo", "age": 59, "title": "General Counsel, Company Secretary & Compliance Officer", "yearBorn": 1966, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Pragnya  Ram", "age": 80, "title": "Group Executive President of Corporate Communications & CSR", "yearBorn": 1945, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Avneesh  Khosla", "title": "Chief Marketing Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Gurucharan Singh Gandhi", "title": "Chief Human Resource Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. T. G. B. Ramakrishna", "age": 66, "title": "Chief Operating Officer of Andhra Pradesh", "yearBorn": 1959, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajesh  Naik", "title": "Chief Operating Officer of Madhya Pradesh & Chattisgarh", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajinder  Singh", "title": "Executive Vice President", "exercisedValue": 0, "unexercisedValue": 0}], "auditRisk": 3, "boardRisk": 8, "compensationRisk": 10, "shareHolderRightsRisk": 1, "overallRisk": 9, "governanceEpochDate": 1777593600, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClo