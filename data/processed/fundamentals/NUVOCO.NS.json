{"info": {"address1": "Equinox Business Park, Tower-3", "address2": "East Wing, 4th Floor Off Bandra-Kurla Complex LBS Road, Kurla (West)", "city": "Mumbai", "zip": "400070", "country": "India", "phone": "91 22 6769 2500", "fax": "91 22 6630 6510", "website": "https://www.nuvoco.com", "industry": "Building Materials", "industryKey": "building-materials", "industryDisp": "Building Materials", "sector": "Basic Materials", "sectorKey": "basic-materials", "sectorDisp": "Basic Materials", "longBusinessSummary": "Nuvoco Vistas Corporation Limited manufactures and sale of cement and building materials products in India. It operates through Cement, and RMX and Other divisions. The company offers ordinary Portland, Portland slag, Portland pozzolana, and Portland composite cement products under the Concreto Uno, Duraguard, Double Bull, PSC, Nirmax, and Infracem brands; and ready-mix concrete under the Concreto, Ecodure, Artiste, InstaMix, and X-Con brands. It also provides modern building materials, such as construction chemicals, multipurpose bonding and waterproofing agents, wall putty, tile and stone adhesives, tile grouts, ready-mix dry plaster, block joining mortar, dry bag concrete. and cover blocks products under the Zero M brands. The company was formerly known as Lafarge India Limited and changed its name to Nuvoco Vistas Corporation Limited in April 2017. The company was incorporated in 1999 and is headquartered in Mumbai, India. Nuvoco Vistas Corporation Limited is a subsidiary of Niyogi Enterprise Private Limited.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Jayakumar  Krishnaswamy BE", "age": 59, "title": "MD & Director", "yearBorn": 1966, "fiscalYear": 2025, "totalPay": 81900000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Maneesh  Agrawal", "age": 50, "title": "Chief Financial Officer", "yearBorn": 1975, "fiscalYear": 2025, "totalPay": 22019000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Bishnu  Sharma", "title": "Head of Investor Relations", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Shruta Jatin Sanghavi", "title": "Senior VP, Company Secretary & Compliance Officer", "fiscalYear": 2025, "totalPay": 8005000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Manisha  Kelkar", "title": "Chief Human Resources Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 320.9, "open": 325.0, "dayLow": 324.1, "dayHigh": 332.1, "regularMarketPreviousClose": 320.9, "regularMarketOpen": 325.0, "regularMarketDayLow": 324.1, "regularMarketDayHigh": 332.1, "payoutRatio": 0.0, "beta": 0.27, "trailingPE": 32.18254, "forwardPE": 21.291077, "volume": 114906, "regularMarketVolume": 114906, "averageVolume": 534040, "averageVolume10days": 327008, "averageDailyVolume10Day": 327008, "bid": 324.35, "ask": 324.7, "marketCap": 115861454848, "nonDilutedMarketCap": 115147143727, "fiftyTwoWeekLow": 276.25, "fiftyTwoWeekHigh": 477.5, "allTimeHigh": 577.9, "allTimeLow": 260.25, "priceToSalesTrailing12Months": 1.02186, "fiftyDayAverage": 303.431, "twoHundredDayAverage": 363.015, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "INR", "tradeable": false, "enterpriseValue": 162811052032, "profitMargins": 0.031689998, "floatShares": 99929796, "sharesOutstanding": 357156153, "heldPercentInsiders": 0.72018, "heldPercentInstitutions": 0.1882, "impliedSharesOutstanding": 357156153, "bookValue": 286.392, "priceToBook": 1.1327132, "lastFiscalYearEnd": 1774915200, "nextFiscalYearEnd": 1806451200, "mostRecentQuarter": 1774915200, "earningsQuarterlyGrowth": -0.15, "netIncomeToCommon": 3593499904, "trailingEps": 10.08, "forwardEps": 15.23643, "enterpriseToRevenue": 1.436, "enterpriseToEbitda": 8.768, "52WeekChange": -0.09960717, "SandP52WeekChange": 0.26208222, "quoteType": 