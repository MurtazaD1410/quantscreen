{"info": {"address1": "1051, Outside Industrial Area", "city": "Jalandhar", "zip": "144004", "country": "India", "phone": "91 18 1500 1111", "fax": "91 18 1229 0611", "website": "https://www.atamvalves.in", "industry": "Specialty Industrial Machinery", "industryKey": "specialty-industrial-machinery", "industryDisp": "Specialty Industrial Machinery", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Atam Valves Limited manufactures and sells valves, fittings, steam traps, and strainers in India, Nepal, Indonesia, South Africa, Dubai, and internationally. The company offers cocks and boiler mountings; air, ball, butterfly, check, foot, gate, globe, needle, non-return, parallel slide blow off, plug, pressure reducing, safety, steam stop, drop forged stainless steel needle valve, screwed ends, steel and high-pressure steel fittings; fusible plugs; moisture separators; sight flow; and water level gauges. It serves the oil and gas refinery, petrochemical, power generation plant, boiler manufacturing, power transformer manufacturing, sugar, textile, rubber, pharmaceutical, chemical, fertilizer, paper, processing, marine and ship building, infrastructure and household, and plumbing industries. The company sells its products under the ATAM and FEBI brands through dealers. Atam Valves Limited was founded in 1972 and is headquartered in Jalandhar, India.", "fullTimeEmployees": 228, "companyOfficers": [{"maxAge": 1, "name": "Mr. Vimal Parkash Jain", "age": 77, "title": "Founder & Chairman", "yearBorn": 1948, "fiscalYear": 2025, "totalPay": 7262500, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Amit  Jain", "age": 48, "title": "MD & Director", "yearBorn": 1977, "fiscalYear": 2025, "totalPay": 9637500, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Pamila  Jain", "age": 47, "title": "CFO & Whole-Time Director", "yearBorn": 1978, "fiscalYear": 2025, "totalPay": 6035000, "exer