{"info": {"address1": "NBCC Bhawan", "address2": "Lodhi Road", "city": "New Delhi", "zip": "110003", "country": "India", "phone": "91 11 2436 7314", "fax": "91 11 2436 6995", "website": "https://www.nbccindia.in", "industry": "Engineering & Construction", "industryKey": "engineering-construction", "industryDisp": "Engineering & Construction", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "NBCC (India) Limited engages in project management consultancy, engineering procurement and construction, and real estate development businesses in India and internationally. It offers services for various civil construction projects, including residential and commercial complexes, re-development of old government colonies, education and medical institutions, infrastructure project roads, water supply systems, storm water systems, and water storage solutions. The company executes various projects, which include high-rise chimneys, cooling towers, coal handling plants, etc.; project conceptualization, feasibility studies, detailed project reports, tender specifications and various packages, basic and detailed engineering, review of projects, procurement, construction, drawings, commissioning & testing, and handing it over. In addition, the company undertakes real estate projects, which include residential and commercial projects, such as corporate office buildings and commercial complexes; develops real estate projects including residential, commercial and institutional projects. Further, it is also involved in the development of integrated steel plants; post-construction maintenance services; consultancy services in healthcare and related social sectors; designs and constructs the India Pavilion; and construction and redevelopment projects both in India and internationally. The company was formerly known as National Buildings Construction Corporation Limited and changed its name to NBCC (India) Limited in May 2016. The company was incorporated in 1960 and is headquartered in New Delhi, India.", "fullTimeEmployees": 1172, "companyOfficers": [{"maxAge": 1, "name": "Dr. Kellambally Puttaswamy Mahadevaswamy", "age": 57, "title": "Chairman & MD", "yearBorn": 1968, "fiscalYear": 2025, "totalPay": 9712627, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Anjeev Kumar Jain", "age": 57, "title": "Director of Finance, CFO & Whole-Time Director", "yearBorn": 1968, "fiscalYear": 2025, "totalPay": 3978991, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Deepti  Gambhir", "title": "Compliance Officer & Company Secretary", "fiscalYear": 2025, "totalPay": 5430000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Suman  Kumar", "age": 57, "title": "Director of Commercial & Whole-Time Director", "yearBorn": 1968, "fiscalYear": 2025, "totalPay": 8286080, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Gita  Rani", "title": "Chief Internal Auditor", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. M. B. Singhal", "title": "Chief General Manager of Finance", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. C.  Mani", "title": "Chief General Manager of Engineering", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Ritu  Pande", "title": "Chief Vigilance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 94.82, "open": 95.68, "dayLow": 95.4, "dayHigh": 99.5, "regularMarketPreviousClose": 94.82, "regularMarketOpen": 95.68, "regularMarketDayLow": 95.4, "regularMarketDayHigh": 99.5, "dividendRate": 0.68, "dividendYield": 0.72, "exDividendDate": 1771977600, "payoutRatio": 0.4504, "fiveYearAvgDividendYield": 0.89, "beta": 0.667, "trailingPE": 40.971073, "forw