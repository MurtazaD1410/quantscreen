{"info": {"address1": "Plot No. H-109", "address2": "MIDC Ambad", "city": "Nashik", "zip": "422010", "country": "India", "phone": "91 25 3664 2000", "fax": "91 25 3238 2975", "website": "https://www.mahindrairrigation.com", "industry": "Farm & Heavy Construction Machinery", "industryKey": "farm-heavy-construction-machinery", "industryDisp": "Farm & Heavy Construction Machinery", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Mahindra EPC Irrigation Limited manufactures, sells, and markets micro irrigation systems in India and Uganda. The company's drip irrigation products include online drip irrigation products, such as drippers and plain irrigation lateral products; and inline drip irrigation products comprising non-pressure compensating (PC) flat, non-PC round, PC flat, and LITE products. It also offers drip irrigation components consisting of plastic and metallic hydro-cylone, vertical and horizontal sand, plastic and metal shell screen, disc, and semi-automatic screen filters; metallic and plastic header assemblies; venturies and fertilizer tanks; PP ball, butterfly, non-return, and PP flush control valves; pressure relief, vacuum breaker, and air release safety valves; and aquafit laterals accessories comprising straight connector, bend, equal tee, and start nipple. In addition, the company provides sprinkler irrigation products, such as various sprinklers, quick pipes coupling sprinkler pipes and fittings, and rainguns; automation systems; protected cultivation; HDPE pipes and coils; and DIY kits, including water reservoir, tubing, drip emitters, and fittings. Further, it offers agricultural services; crop advisory for land preparation, drip system selection, crop and irrigation management, and fertigation management; and technical services, including operation and maintenance training, and chemical treatment. The company also exports its products. The company was formerly known as EPC Industrie Limited and changed its name to Mahindra EPC Irrigation Limited in February 2019. Mahindra EPC Irrigation Limited was incorporated in 1981 and is based in Nashik, India. Mahindra EPC Irrigation Limited is a subsidiary of Mahindra & Mahindra Limited.", "fullTimeEmployees": 327, "companyOfficers": [{"maxAge": 1, "name": "Mr. Abhijit  Page", "title": "Chief Executive Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Giriraj  Mohta", "title": "Chief Financial Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ramesh  Ramachandran", "age": 56, "title": "MD & Director", "yearBorn": 1969, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Padam kumar Gandhi", "title": "Head of Operations", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Madhvendra Pratap Singh", "title": "Company Secretary & Compliance Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajesh  Dhote", "title": "Head Sales & Marketing", "exercisedValue": 0, "unexercisedValue": 0}], "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 117.24, "open": 119.86, "dayLow": 118.0, "dayHigh": 119.86, "regularMarketPreviousClose": 117.24, "regularMarketOpen": 119.86, "regularMarketDayLow": 118.0, "regularMarketDayHigh": 119.86, "exDividendDate": 1626307200, "payoutRatio": 0.0, "beta": 0.458, "trailingPE": 26.114536, "volume": 8936, "regularMarketVolume": 8936, "averageVolume": 47285, "averageVolume10days": 22708, "averageDailyVolume10Day": 22708, "bid": 118.25, "ask": 118.64, "marketCap": 3313841152, "nonDilutedMarketCap": 3270238101, "fiftyTwoWeekLow": 91.91, "fiftyTwoWeekHigh": 185.12, "allTimeHigh": 194.5, "allTimeLow": 70.8, "priceToSalesTrailing12Months": 1.0618223, "fiftyDayAverage": 114.502, "twoHundredDayAverage": 130.5203, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "INR", "tradeable": false, "enterpriseValue": 372877516