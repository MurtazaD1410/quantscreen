{"info": {"address1": "Electronic City", "address2": "39-42, Phase II Hosur Road", "city": "Bengaluru", "zip": "560100", "country": "India", "phone": "91 80 4136 2000", "fax": "91 80 4136 2010", "website": "https://www.timken.com/en-in", "industry": "Tools & Accessories", "industryKey": "tools-accessories", "industryDisp": "Tools & Accessories", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Timken India Limited manufactures, sells, and distributes tapered and other roller bearings, components, accessories, and mechanical power transmission products in India, the United States, and internationally. The company offers engineered bearing products, such as ball, plain, precision, and needle and thrust bearings; cylindrical, energy efficient, spherical, and tapered roller bearings; housed and premium wheel hub units; and driveline center support bearings for commercial and light vehicles, as well as aerospace, industrial, and rail bearing repair services. It also provides mechanical power transmission products, including seals, maintenance tools, lubrication and filtration solutions, encoders, gear boxes/transmissions, couplings and joints, belts, augers, linear motion products, brakes and clutches, commercial vehicles wheel end accessories and tools, and chains. In addition, the company offers maintenance contract and refurbishment services. It sells its products under the TIMKEN, ROLLON, PHILADELPHIA GEAR, GGB, GROENEVELD, BEKA, Cone Drive, NADELLA, Lovejoy, DIAMOND, DRIVES, SPINEA, PTTECH, LAGERSMIT, TORSION CONTROL PRODUCTS, DES-CASE, and other brands. The company serves various markets, including defense, mining, metals, civil aerospace, commercial vehicles, agriculture, energy, rail, automotive, construction, outdoor power equipment, and industrial equipment and machinery. The company was formerly known as Tata Timken Limited and changed its name to Timken India Limited in July 1999. The company was incorporated in 1987 and is based in Bengaluru, India. Timken India Limited operates as a subsidiary of Timken Singapore Pte Ltd.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Sanjay  Koul", "age": 61, "title": "Executive Non-Independent Chairman, MD & CEO", "yearBorn": 1964, "fiscalYear": 2025, "totalPay": 65172769, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sujit Kumar Pattanaik", "age": 45, "title": "Business Controller of India, CFO & Whole-time Director", "yearBorn": 1980, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Adi Narayan Rao", "title": "Head of Facilities & Administration", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Mandar Mohaniraj Vasmatkar", "title": "Company Secretary & Chief of Compliance", "fiscalYear": 2025, "totalPay": 2840962, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Regina  Vasudevan", "title": "Head of Communications", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. H.  Vamanamoorthy", "title": "Head \u0096 CI, Strategic Project, Sustainability & ESG", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Shesh M. Kumar", "title": "Head of Marketing - India", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sudharsan  Gopalan", "title": "Head of Production - Timken Group Entity Plant", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 3750.2, "open": 3750.2, "dayLow": 3626.8, "dayHigh": 3775.0, "regularMarketPreviousClose": 3750.2, "regularMarketOpen": 3750.2, "regularMarketDayLow": 3626.8, "regularMarketDayHigh": 3775.0, "dividendRate": 36.0, "dividendYield": 0.96, "exDividendDate": 1753401600, "payoutRatio": 0.65260005, "fiveYearAvgDividendYield"