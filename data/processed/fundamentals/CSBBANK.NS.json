{"info": {"address1": "CSB Bhavan", "address2": "St. Mary's College Road PO Box No. 502", "city": "Thrissur", "zip": "680020", "country": "India", "phone": "91 48 7661 9219", "fax": "91 48 7233 8764", "website": "https://www.csb.bank.in", "industry": "Banks - Regional", "industryKey": "banks-regional", "industryDisp": "Banks - Regional", "sector": "Financial Services", "sectorKey": "financial-services", "sectorDisp": "Financial Services", "longBusinessSummary": "CSB Bank Limited provides banking and financial services for small and medium enterprises, retail, and non-resident individuals in India. The company operates through Treasury, Corporate/Wholesale Banking, Retail Banking, and Other Banking Operations segments. It offers savings and current, salary/payroll, and fixed and recurring deposit accounts, as well as family banking and segmented products; insurance products, such as life, health, and general insurances, as well as social security schemes; personal, gold, vehicle, home, small business, agriculture, and educational loans, as well as MFI Loans, two-wheeler loans, and healthcare finance; loan against securities and property; doorstep banking services, such as cash pickup and cash delivery, and cheque pickup and reconciliation; and corporate internet banking. The company also provides investment services, such as e-trade and sovereign gold bond; credit and debit cards; digital access and value added services; NRI banking services including NRO, NRE, FCNR, and RFC accounts; and forex services, including outward remittance, foreign currency cash, and integrated treasury services, as well as Agri-banking and financial inclusion services. In addition, it offers SME and corporate banking services, which includes term and working capital loans, export and import finance, letter of credit, buyer and suppliers credit, commercial vehicle and consumption loans, bill discounting, trade and bill finance, cash management, and bank guarantee; ATMs and CDMs; internet, mobile, and WhatsApp banking; and locker facilities. CSB Bank Limited was formerly known as The Catholic Syrian Bank Limited. CSB Bank Limited was incorporated in 1920 and is headquartered in Thrissur, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Pralay  Mondal", "age": 60, "title": "MD, CEO & Director", "yearBorn": 1965, "fiscalYear": 2025, "totalPay": 34901669, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. B. K. Divakara A.C.A., A.C.M.A., A.C.S., BBM", "age": 65, "title": "Executive Director", "yearBorn": 1960, "fiscalYear": 2025, "totalPay": 10260555, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Satish  Gundewar", "age": 53, "title": "Chief Financial Officer", "yearBorn": 1972, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. K.  Chandrasekhar", "title": "Head of Operations", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajesh  Choudhary", "title": "Chief Technology Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ajith  Jose", "title": "Chief Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Chinmay Pradeep Adhikari", "age": 46, "title": "Chief Human Resources Officer", "yearBorn": 1979, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Narendra Kumar Dixit", "title": "Head of Retail Banking", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Shyam Chandher Mani", "title": "Head of SME & NRI Business", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Manish  Agarwal", "title": "Chief Credit Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose"