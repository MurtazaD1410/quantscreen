{"info": {"address1": "The Lattice, Old No. 7/1", "address2": "New No. 20, 4th Floor Bishop Ezra Sargunam Road Kilpauk", "city": "Chennai", "zip": "600010", "country": "India", "phone": "91 44 4340 9494", "website": "https://jainmetalgroup.com", "industry": "Other Industrial Metals & Mining", "industryKey": "other-industrial-metals-mining", "industryDisp": "Other Industrial Metals & Mining", "sector": "Basic Materials", "sectorKey": "basic-materials", "sectorDisp": "Basic Materials", "longBusinessSummary": "Jain Resource Recycling Limited engages in the manufacture and export of non-ferrous metal products by way of recycling of non-ferrous metal scrap. The company offers lead and lead alloy ingots, copper and copper ingots, and aluminum and aluminum alloys. It also engages in the non-ferrous recycling of copper, lead, and aluminum; trading of non-ferrous scrap that include nickel cathode, silicon metal, tin ingots, and zinc ingots and other products. In addition, the company offers copper products that include refined copper billet and finished copper scrap; lead products that include refined lead ingots, antimony lead ingots, and remelted lead ingots; and aluminum products that include aluminum alloy ingots and molten aluminum alloys. Jain Resource Recycling Limited was founded in 1950 and is based in Chennai, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Kamlesh S. Jain", "age": 57, "title": "Chairman & MD", "yearBorn": 1968, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Mayank  Pareek", "age": 53, "title": "Joint MD & Director", "yearBorn": 1972, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Hemant Shantilal Jain", "age": 41, "title": "CFO & Executive Director", "yearBorn": 1984, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Bibhu Kalyan Rauta", "title": "Company Secretary & Compliance Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Vijay  Kumar", "title": "Chief Operating Officer", "exercisedValue": 0, "unexercisedValue": 0}], "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 384.85, "open": 390.05, "dayLow": 385.2, "dayHigh": 391.75, "regularMarketPreviousClose": 384.85, "regularMarketOpen": 390.05, "regularMarketDayLow": 385.2, "regularMarketDayHigh": 391.75, "payoutRatio": 0.0, "trailingPE": 37.30991, "forwardPE": 20.841396, "volume": 767242, "regularMarketVolume": 767242, "averageVolume": 2683590, "averageVolume10days": 5810387, "averageDailyVolume10Day": 5810387, "bid": 387.6, "ask": 388.0, "marketCap": 133772517376, "nonDilutedMarketCap": 133720752925, "fiftyTwoWeekLow": 247.57, "fiftyTwoWeekHigh": 593.95, "allTimeHigh": 593.95, "allTimeLow": 247.57, "priceToSalesTrailing12Months": 1.4017702, "fiftyDayAverage": 450.224, "twoHundredDayAverage": 409.21774, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "INR", "tradeable": false, "enterpriseValue": 109070532608, "profitMargins": 0.03391, "floatShares": 45187013, "sharesOutstanding": 345085814, "heldPercentInsiders": 0.81768996, "heldPercentInstitutions": 0.068169996, "impliedSharesOutstanding": 345085814, "bookValue": 42.133, "priceToBook": 9.200626, "lastFiscalYearEnd": 1774915200, "nextFiscalYearEnd": 1806451200, "mostRecentQuarter": 1774915200, "earningsQuarterlyGrowth": -0.275, "netIncomeToCommon": 3272669952, "trailingEps": 10.39, "forwardEps": 18.6, "enterpriseToRevenue": 1.143, "enterpriseToEbitda": 19.514, "52WeekChange": 0.20999181, "SandP52WeekChange": 0.26208222, "quoteType": "EQUITY", "currentPrice": 387.65, "targetHighPrice": 560.0, "targetLowPrice": 418.0, "targetMeanPrice": 489.0, "targetMedianPrice": 489.0, "recommendationMean": 2.0, "recommendationKey": "buy", "numberOfAnalystOpinions": 2, "totalCash": 3652489984, "totalCashPerShare": 14.057, "ebitda": 5589320192, "totalDebt": 12758859776, "quickRatio": 0.476, "currentRatio": 1.802, "totalRevenue": 95431131136, "debtToEquity": 