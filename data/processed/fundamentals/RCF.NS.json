{"info": {"address1": "Priyadarshini", "address2": "Eastern Express Highway Sion", "city": "Mumbai", "zip": "400 022", "country": "India", "phone": "91 22 2404 5024", "fax": "91 22 2404 5111", "website": "https://www.rcfltd.com", "industry": "Agricultural Inputs", "industryKey": "agricultural-inputs", "industryDisp": "Agricultural Inputs", "sector": "Basic Materials", "sectorKey": "basic-materials", "sectorDisp": "Basic Materials", "longBusinessSummary": "Rashtriya Chemicals and Fertilizers Limited manufactures, markets, and sells fertilizers and industrial chemicals in India. The company operates through Fertilizers, Industrial Chemicals, and Trading segments. It offers various fertilizers, including Suphala 15:15:15, a NPK fertilizer; Urea, a nitrogenous fertilizer; Biola, a bio-fertilizer; Sujala, a water-soluble fertilizers; Microla micronutrients fertilizer; Vipula, a suspension NPK fertilizers; and Geola, a revolutionary biofertilizer product with NPK bacterial consortia in lyophilized form, as well as water pH balancer, soluble silicon fertilizer, organic growth stimulant, phosphate rich organic manure, and PDM-Potash. The company also provides industrial chemicals, such ammonium nitrate melt, ammonia, ammonium, ammonium bicarbonate, dilute nitric acid, nitric acid, methylamines, sulphuric acid, argon, nitrogen, dimethyl acetamide, phosphoric acid, sodium nitrate/nitrite, methanol, gypsum, chalk, etc., as well as mono, die, and tri methyl amine. In addition, it involved in agriculture extension activities, such as soil sample analysis and farmer training services; printing and distribution of RCF Sheti Patrika for farmers; and development of drone hubs. Further, the company organize broadcasting of farming related community radio programs, including Samrudha Shetitun Vikasit Bharat. Rashtriya Chemicals and Fertilizers Limited was incorporated in 1978 and is based in Mumbai, India.", "fullTimeEmployees": 2620, "companyOfficers": [{"maxAge": 1, "name": "Ms. Nazhat J. Shaikh", "age": 58, "title": "CFO, Director of Finance & Director", "yearBorn": 1967, "fiscalYear": 2025, "totalPay": 7000000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Ritu  Goswami", "age": 58, "title": "Director of Technical & Director", "yearBorn": 1967, "fiscalYear": 2025, "totalPay": 5300000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Jai Bhagwan Sharma", "title": "Compliance Officer, Executive Director of Admin, Legal & Company Secretary", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Niranjan S. Sonak", "age": 58, "title": "Director of Marketing & Director", "yearBorn": 1967, "fiscalYear": 2025, "totalPay": 1300000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Shivakumar  Subramaniam", "title": "Chairman & Managing Director", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sharad S. Sonawane", "title": "Executive Director of HR", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Nuhu H. Kurane", "title": "Executive Director of Commercial", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Rahul S. Jagtap", "title": "Chief Vigilance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. M.  Ramesh", "title": "Executive Director", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "irWebsite": "http://www.rcfltd.com/index.php/financials", "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 130.78, "open": 132.0, "dayLow": 129.6, "dayHigh": 132.59, "regularMarketPreviousClose": 130.78, "regularMarketOpen": 132.0, "regularMarketDayLow": 129.6, "regularMarketDayHigh": 132.59, "dividendRate": 2.32, "dividendYield": 1.85, "exDividendDate": 1771545600, "payoutRatio": 0.2994, "fiveYearAvgD