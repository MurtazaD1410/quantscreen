{"info": {"address1": "Chandermukhi", "address2": "9th Floor Nariman Point", "city": "Mumbai", "zip": "400021", "country": "India", "phone": "91 22 6638 7777", "website": "https://centralbank.bank.in", "industry": "Banks - Regional", "industryKey": "banks-regional", "industryDisp": "Banks - Regional", "sector": "Financial Services", "sectorKey": "financial-services", "sectorDisp": "Financial Services", "longBusinessSummary": "Central Bank of India operates as a commercial bank in India. The company offers deposit products, which include savings and current accounts, time deposits, fixed deposits, and recurring deposit schemes, as well as small saving scheme; and loans, including housing, vehicle, property, personal, senior citizens, education, and agricultural, as well as micro small and medium enterprises loans. It provides credit, debit, and prepaid/gift cards, as well as cash management, mutual funds, depository, mobile and Internet banking, and ATM services. In addition, the company offers corporate loans, such as project finance, infrastructure funding, financing to infrastructure investment trusts, short term corporate loans, advances, working capital facilities, line of credit, export finance, foreign currency loan, bills purchase/discount/negotiation facilities, non-fund based facilities, and facilities to other industries. Further, the company sells and distributes life, general, and health insurance products, including unit linked, whole life, children, money back, endowment, pension, health, property, personal, fire, burglary, engineering, motor, package, travel, and group insurance products, as well as protection and retirement solutions. It operates through a network of branches, ATMs, satellite offices, and an extension counter. Central Bank of India has a strategic co lending partnership with IIFL Home Finance Limited to offer SME LAP loan products under priority sector to MSME borrowers. Central Bank of India was incorporated in 1911 and is headquartered in Mumbai, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Malladi Venkat Murali Krishna", "age": 58, "title": "Executive Director", "yearBorn": 1967, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Mahendra Dwarika Prasad Dohare", "age": 54, "title": "Executive Director", "yearBorn": 1971, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Kalyan  Kumar", "age": 56, "title": "MD & CEO", "yearBorn": 1969, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Mukul N. Dandige", "age": 58, "title": "GM of F&A and CFO", "yearBorn": 1967, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Kavita  Thakur", "age": 55, "title": "GM of Compliance Department & Chief Compliance Officer", "yearBorn": 1970, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Bhaskar  Gorugantu", "age": 51, "title": "Chief Risk Officer", "yearBorn": 1974, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sunil  Arora", "title": "Chief Vigilance Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. E. Ratan Kumar", "title": "Executive Director", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Vijay Vasantrao Murar", "title": "General Manager of Treasury & ID", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Chandrakant C. Bhagwat", "age": 37, "title": "Assistant GM, Company Secretary & Compliance Officer", "yearBorn": 1988, "exercisedValue": 0, "unexercisedValue": 0}], "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 31.27, "open": 31.29, "dayLow": 31.11, "dayHigh": 31.33, "regularMarketPreviousClose": 31.27, "regularMarketOpen": 31.29, "regularMarketDayLow": 31.11, "regularMarketDayHigh": 31.33, "dividendRate": 1.39, "dividendYield": 4.44, "exDividendDate": 1778198400, "payoutRatio": 0.1575, "fiveYearAvgDividendYield": 2.49, "beta": 0.521, "trailingPE": 6.2580004