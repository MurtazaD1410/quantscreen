{"info": {"address1": "Plot No. 5 & 6, 2nd Stage", "address2": "Disha - 3rd Floor Peenya Industrial Area IV Peenya", "city": "Bengaluru", "zip": "560058", "country": "India", "phone": "91 80 2294 9150", "fax": "91 80 2294 9148", "website": "https://new.abb.com/indian-subcontinent", "industry": "Specialty Industrial Machinery", "industryKey": "specialty-industrial-machinery", "industryDisp": "Specialty Industrial Machinery", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "ABB India Limited develops and sells products and system solutions to utilities, industries, channel partners, and original equipment manufacturers in India and internationally. It operates through Motion, Robotics and Discrete Automation, Electrification, and Process Automation segments. The Motion segment offers motors, generators, and drives that provide power, motion, and control for a range of automation applications; as well as solutions and related services. Its Robotics and Discrete Automation segment provides value-added solutions in robotics, machine, and factory automation. The Electrification segment offers a range of digital and connected solutions for low- and medium-voltage applications, including EV infrastructure, solar inverters, modular substations, distribution automation, power protection, wiring accessories, switchgear, enclosures, cabling, sensing, and control. Its Process Automation segment provides products, systems, and services, such as turnkey engineering, control systems, measurement products, life cycle services, outsourced maintenance, and industry specific products for the optimization of the productivity of industrial processes in oil and gas, power, chemicals and pharmaceuticals, pulp and paper, metals and minerals, marine, and turbocharging industries. The company was formerly known as ABB Limited and changed its name to ABB India Limited in June 2013. ABB India Limited was incorporated in 1949 and is headquartered in Bengaluru, India. ABB India Limited operates as a subsidiary of ABB Asea Brown Boveri Ltd", "fullTimeEmployees": 3859, "companyOfficers": [{"maxAge": 1, "name": "Mr. Sanjeev  Sharma", "age": 60, "title": "MD & Director", "yearBorn": 1965, "fiscalYear": 2025, "totalPay": 59384000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. T. K. Sridhar", "title": "CFO & Chief Investor Relations Officer", "fiscalYear": 2025, "totalPay": 17153930, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Trivikram  Guda", "title": "Compliance Officer, Company Secretary & Global Head of Labor and Employment of Motion", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Sohini  Mookherjea", "title": "Head of Corporate Communications", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Vaibhav  Srivastava", "title": "Country Human Resources Head", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. G. N. V. Subba Rao", "title": "Head of India Centre for Global R&D", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sanjeev  Arora", "title": "President of Motion Markets", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Subrata  Karmakar", "title": "President of Robotics & Discrete Automation", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. G.  Balaji", "title": "President of Energy Industries Division Process Automation", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Kiran  Dutt", "title": "President of Electrification Products", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "auditRisk": 8, "boardRisk": 3, "compensationRisk": 5, "shareHolderRightsRisk": 8, "overallRisk": 4, "governanceEpochDate": 1777593600, "compensationAsOfE