{"info": {"address1": "11 B/2 (S.P), First Cross Road", "address2": "Sai Nagar, Ambattur Industrial Estate Ambattur", "city": "Chennai", "zip": "600058", "country": "India", "phone": "91 44 6654 4719", "fax": "91 44 2860 4788", "website": "https://www.ucalfuel.com", "industry": "Auto Parts", "industryKey": "auto-parts", "industryDisp": "Auto Parts", "sector": "Consumer Cyclical", "sectorKey": "consumer-cyclical", "sectorDisp": "Consumer Cyclical", "longBusinessSummary": "UCAL Limited engages in the manufacturers of fuel management systems for the automotive sector in India. The company offers air & fuel systems emission controls, powertrain, including fuel injection system parts, mechanical carburetor, mechanical throttle body assembly, intake throttle valve, electronic throttle body, hydro carbon doser, fuel rails, electric air suction valve, electric purge valve, solenoid variable valve timing, and diesel fuel filter housing; pumps, such as oil pump, variable pressure oil pump, variable displacement oil pump, vacuum pump, electric vacuum pump, electric coolant pump, and electric oil pump. It also offers automotive electronics, including 3-in-1 sensors, t-map sensors, fuel level sensors, tyre pressure monitoring sensors, reverse parking sensors, hall / inductive sensors, CR controllers, timers, relays & controllers, DC DC converters, ecu speed modules, reverse speed modules, sound alerts (e-horn), indicators, ems services, and buzzer / hooter; manufacturing services, such as pressure die casting products, precision machined parts &, components for automotive, and applications; and built-to-print curated products, includes water outlet, and accelerated pedal sensors. In addition, the company offers engineering services, which include analysis and benchmarking; design, drawing, and modelling; computational analysis and simulation; testing and validation; design for manufacturing; system calibration; and value addition/value engineering services. The company sells its products under the UCAL brand. It also exports its products. The company was formerly known as UCAL Fuel Systems Limited and changed its name to UCAL Limited in June 2023. UCAL Limited was incorporated in 1985 and is based in Chennai, India.", "fullTimeEmployees": 630, "companyOfficers": [{"maxAge": 1, "name": "Mr. Jayakar  Krishnamurthy", "age": 65, "title": "Chairman & MD", "yearBorn": 1960, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. T.  Jaisankar", "title": "Chief Executive Officer", "fiscalYear": 2025, "totalPay": 6225790, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. M.  Manikandan", "title": "Chief Financial Officer", "fiscalYear": 2025, "totalPay": 4478000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Subramanian  Narayan", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "totalPay": 2876000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Adithya  Jayakar", "title": "Chief Marketing Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ram  Ramamurthy", "age": 77, "title": "Whole Time Director", "yearBorn": 1948, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. B.  Srinivasan", "title": "Chief Technical Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Gowri  Shankar", "title": "Head - HR", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Peter Thomas Langford", "title": "Head - Program Management System", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. V.  Girinarayanan", "title": "Head of Electronics", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 89.3, "open": 91.69, "dayLo