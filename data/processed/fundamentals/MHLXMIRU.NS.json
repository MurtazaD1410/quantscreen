{"info": {"address1": "Mahalaxmi House", "address2": "YSL Avenue Opp. Ketav Petrol Pump Polytechnic Road, Ambawadi", "city": "Ahmedabad", "zip": "380015", "country": "India", "phone": "91 79 4000 8000", "fax": "91 79 2658 3552", "website": "https://mrtglobal.com", "industry": "Textile Manufacturing", "industryKey": "textile-manufacturing", "industryDisp": "Textile Manufacturing", "sector": "Consumer Cyclical", "sectorKey": "consumer-cyclical", "sectorDisp": "Consumer Cyclical", "longBusinessSummary": "Mahalaxmi Rubtech Limited engages in the manufacture and marketing of traditional textile, and polymer based technical textile and rubber products in India. It offers Imprint Technology, including underlay, xpeedo-web, rapid-web, print UV, royal green, robusto, spectra, stripcoat, ultra, and polset for sheetfed/conventional, UV printing, packaging, stripping coating, metal deco, newspaper/web, security printing, and under packing. The company also provides technical coated fabrics, such as PVC, media/acrylic, polyurethane coated fabric, and miscellaneous fabric coating for architecture, lifestyle, sports, advertising, military, mines, food and agriculture, vehicle, and transportation applications. In addition, it offers grey fabrics under the Maheeka brand name. Mahalaxmi Rubtech Limited was incorporated in 1991 and is based in Ahmedabad, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Rahul Jeetmal Parekh", "age": 53, "title": "MD & Executive Director", "yearBorn": 1972, "fiscalYear": 2025, "totalPay": 2432400, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Anand Jeetmal Parekh", "age": 49, "title": "Joint MD & Director", "yearBorn": 1976, "fiscalYear": 2025, "totalPay": 2432400, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Kaluram Birdaram Gurjar", "title": "Chief Financial Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Karan Rajivbhai Parikh", "title": 