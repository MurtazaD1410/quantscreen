{"info": {"address1": "DLF Industrial Estate", "address2": "Plot No. 4, 5A", "city": "Faridabad", "zip": "121003", "country": "India", "phone": "91 12 9227 0621", "fax": "91 12 9227 7359", "website": "https://www.stlfasteners.com", "industry": "Tools & Accessories", "industryKey": "tools-accessories", "industryDisp": "Tools & Accessories", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Sterling Tools Limited manufactures and sells high tensile cold forged fasteners to original equipment manufacturers in India. It offers standard, special, chassis, and engine fasteners, axle, engine, and standard bolts, as well as hub/wheel bolts, hub nuts, wheel studs, and motor control units for electric vehicles. The company also manufactures and trades in motor control units, manufactures magnet-free motors and associated powertrain components, manufactures motor vehicle electrical equipment, and designs, develops, manufactures, and promotes mechanical and electrical components. Its products are used in the automotive industry, catering to passenger and commercial vehicles, three-wheelers, two-wheelers, and quadricycles. In addition, the company engages in investment activities. It also exports its products to Europe, the United States, South America, and the Middle East. Sterling Tools Limited was incorporated in 1979 and is based in Faridabad, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Anil  Aggarwal", "age": 67, "title": "CEO, Chairman & Whole Time Director", "yearBorn": 1958, "fiscalYear": 2025, "totalPay": 34097000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Atul  Aggarwal", "age": 61, "title": "MD & Director", "yearBorn": 1964, "fiscalYear": 2025, "totalPay": 33620000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Amitrajit  Sinha", "age": 58, "title": "Chief Manufacturing Officer", "yearBorn": 1967, "fiscalYear": 2025, "exercisedValue": 0, "unexerc