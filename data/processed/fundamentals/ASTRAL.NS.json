{"info": {"address1": "Astral House", "address2": "207/1, Behind Rajpath Club Off S. G. Highway", "city": "Ahmedabad", "zip": "380059", "country": "India", "phone": "91 79 6621 2000", "fax": "91 79 6621 2121", "website": "https://astralltd.com", "industry": "Building Products & Equipment", "industryKey": "building-products-equipment", "industryDisp": "Building Products & Equipment", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Astral Limited engages in the manufacture and marketing of pipes and fittings, water tanks, and adhesives and sealants in India and internationally. It operates in two segments, Plumbing, and Paints and Adhesives. It offers plumbing pipes and fittings, sewerage and drainage pipes and fittings, agriculture pipes and fittings, cable protection system, industrial piping system, fire protection system, urban infrastructure, ancillary products, and column pipe; and roto moulding, blow moulded, loft, and anti-viral copper shield water tanks. It also provides bath-ware products comprising faucets, sanitarywares, cisterns, and showers; paints, such as interior and exterior emulsions, distempers, enamels, and primer and wall putty undercoats; adhesives and sealants, including epoxy, PVA, rubber, anaerobic tapes, silicone, acrylic, hybrid, instant, solvent, specialised, industrial adhesives, and epoxy putty; specialized valves, such as compact true, single union, and industrial ball valves; construction chemicals comprising bathroom and basement waterproofing, tile adhesives and grouts, exterior roof and wall coatings, polymers and integral compounds, and repair products; and infrastructure products comprising drainage, cable protection, and PT duct systems; and specialised fittings, such as electrofusion, compression, PPR fittings, integrated and mechanica clamp, integrated composite strap-on saddles, PVC conduit for concealed wiring system, and investment castings. The company was formerly known as Astral Poly Technik Limited and changed its name to Astral Limited in April 2021. Astral Limited was incorporated in 1996 and is headquartered in Ahmedabad, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Sandeep Pravinbhai Engineer", "age": 64, "title": "MD & Chairman of the Board", "yearBorn": 1961, "fiscalYear": 2025, "totalPay": 151680000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Hiranand A. Savlani", "age": 57, "title": "CFO & Whole Time Director", "yearBorn": 1968, "fiscalYear": 2025, "totalPay": 61930000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Jagruti Sandeep Engineer", "age": 60, "title": "Whole-Time Director", "yearBorn": 1965, "fiscalYear": 2025, "totalPay": 17430000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Kairav S. Engineer", "age": 37, "title": "Whole Time Director", "yearBorn": 1988, "fiscalYear": 2025, "totalPay": 17660000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Girish Bhanubhai Joshi", "age": 65, "title": "Whole Time Director", "yearBorn": 1960, "fiscalYear": 2025, "totalPay": 1540000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Chintankumar Mahendrabhai Patel", "age": 38, "title": "Company Secretary & Compliance Officer", "yearBorn": 1987, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Saumya  Engineer", "title": "Chief Executive Officer - Astral Adhesives & Paints", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "auditRisk": 7, "boardRisk": 6, "compensationRisk": 4, "shareHolderRightsRisk": 1, "overallRisk": 4, "governanceEpochDate": 1777593600, "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 1541.7, "open": 1566.0, "dayLow": 1547.7, "dayHigh": 1566.6, "regularMarketPreviousClose": 1541.7, "regularMarketOpen": 1566.0, "regularMarketDayLow": 1547.7, "reg