{"info": {"address1": "Kohinoor City Commercial I", "address2": "510 A Wing Kirol Road, off. L.B. Shastri Marg Kurla West", "city": "Mumbai", "zip": "400070", "country": "India", "phone": "91 22 6708 2600", "fax": "91 22 6708 2599", "website": "https://www.grpweb.com", "industry": "Auto Parts", "industryKey": "auto-parts", "industryDisp": "Auto Parts", "sector": "Consumer Cyclical", "sectorKey": "consumer-cyclical", "sectorDisp": "Consumer Cyclical", "longBusinessSummary": "GRP Limited manufactures and sells reclaimed rubber products for tyre and non-tyre rubber goods in India and internationally. It operates in Reclaim Rubber and Others segments. The company offers reclaim natural and synthetic rubber products for use in inner liners and tubes, tyre side walls and piles, tyre treads and retreads, conveyor belts, moulded goods, adhesives, and footwear, as well as mattings, profiles, and roofing; and POLYCOAT, an elastic powder in compounded form, which is used in NBR based molded products, metal to rubber bonded parts, NBR based oil seals, NBR matting/sheeting, and NBR-PVC blend, as well as use in tyres, conveyor belts, molded products, sheeting/matting, tread rubber, seals/gaskets, and flaps applications. It also provides engineering plastics comprising glass filled and unfilled reprocessed nylon 6 and modified nylon 6,6 used in automotive, electrical and electronics, consumer, and industrial applications; repurposed polyolefins, such as impact copolymer polypropylene, IC PP custom colors, and PP based elastomers used in paint and lubricant pails, automotive battery covers, and pallets; and custom die forms consisting of link, door, and industrial mats, as well as dock bumpers primarily for use in civil and agricultural applications. In addition, the company generates power from windmill; offers polymer composite products, including boards, wheel chocks, and assembled products used in logistics, construction, oil and gas, aviation, marine, industrial, and agriculture applications; and develops poly-blends and thermoplastic elastomers. The company was formerly known as Gujarat Reclaim and Rubber Products Limited and changed its name to GRP Limited in June 2012. GRP Limited was incorporated in 1974 and is headquartered in Mumbai, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Harsh Rajendra Gandhi", "age": 48, "title": "MD & Executive Director", "yearBorn": 1977, "fiscalYear": 2025, "totalPay": 23170600, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Shilpa Narendra Mehta", "title": "VP & CFO", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Hemal Harsh Gandhi", "title": "Executive Director", "fiscalYear": 2025, "totalPay": 3985939, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Kushaba  Giramkar", "title": "President  of Operations, Procurement & Projects", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Kiran  Shetty", "age": 47, "title": "General Manager of Sales", "yearBorn": 1978, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sanjeeb  Lahiri", "age": 52, "title": "Chief Human Resources Officer", "yearBorn": 1973, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 1727.2, "open": 1712.6, "dayLow": 1685.0, "dayHigh": 1726.5, "regularMarketPreviousClose": 1727.2, "regularMarketOpen": 1712.6, "regularMarketDayLow": 1685.0, "regularMarketDayHigh": 1726.5, "dividendRate": 14.5, "dividendYield": 0.84, "exDividendDate": 1752796800, "payoutRatio": 2.4007, "beta": 0.163, "trailingPE": 278.94214, "forwardPE": 14.461011, "volume": 2238, "regularMarketVolume": 2238, "averageVolume": 2981, "averageVolume10days": 5545, "averageDailyVolume10Day": 5545, "bid": 1687.7, "ask": 1689.9, "bidSize": 0, "askSize": 0, "marketCap": 900053