{"info": {"address1": "Blue Dart Centre", "address2": "Sahar Airport Road Andheri (East)", "city": "Mumbai", "zip": "400099", "country": "India", "phone": "91 22 2839 6444", "fax": "91 22 2824 4131", "website": "https://www.bluedart.com", "industry": "Integrated Freight & Logistics", "industryKey": "integrated-freight-logistics", "industryDisp": "Integrated Freight & Logistics", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Blue Dart Express Limited provides courier and express services in India. It provides day-definite and time-definite delivery schedules across air and ground network under the Domestic Priority, Dart Apex, Dart Surfaceline, and Dart Plus names; and door-to-door ground distribution service under the Dart Surfaceline name. The company also offers air freight services between the airports of Kolkata, Mumbai, Delhi, Bangalore, Chennai, Hyderabad, and Ahmedabad; air express and ground express packaging services under the Smart Box name; wood-free palletized packaging; shipment for freight of 50kg, 75kg, or above 100kg; door-to-door express deliveries for documents and shipments; international services; and temperature-controlled logistics solutions, as well as operates domestic express airline charter. It has a fleet of 6 Boeing 757-200 freighters and 2 Boeing 737 aircraft; and a flotilla of various vehicles, facilities, and e-vehicles in India. Blue Dart Express Limited was founded in 1983 and is headquartered in Mumbai, India. Blue Dart Express Limited is a subsidiary of DHL Express (Singapore) Pte. Ltd.", "fullTimeEmployees": 12703, "companyOfficers": [{"maxAge": 1, "name": "Mr. Balfour  Manuel", "age": 64, "title": "MD & Executive Director", "yearBorn": 1961, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Tushar Jayant Gunderia", "title": "Company Secretary and Head of Legal & Compliance", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sagar  Patil", "title": "CFO & Head of Corporate Accounts", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Vikram  Mansukhani", "title": "National Operations Head", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Manoj  Madhavan", "title": "Chief Information Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Beena Mathen Jacob", "title": "Chief Human Resources Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sandeep  Petkar", "title": "Regional Head of South", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Subrata  Biswas", "title": "Regional Head of East", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Nitin  Varkey", "title": "Chief of Staff", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Sonia  Nair", "title": "VP & Head of Customer Service", "exercisedValue": 0, "unexercisedValue": 0}], "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 4851.5, "open": 4865.0, "dayLow": 4865.0, "dayHigh": 4960.0, "regularMarketPreviousClose": 4851.5, "regularMarketOpen": 4865.0, "regularMarketDayLow": 4865.0, "regularMarketDayHigh": 4960.0, "dividendRate": 25.0, "dividendYield": 0.52, "exDividendDate": 1754438400, "payoutRatio": 0.23979999, "fiveYearAvgDividendYield": 0.44, "beta": 0.375, "trailingPE": 46.965775, "forwardPE": 28.449478, "volume": 4581, "regularMarketVolume": 4581, "averageVolume": 14751, "averageVolume10days": 19351, "averageDailyVolume10Day": 19351, "bid": 4891.5, "ask": 4898.5, "bidSize": 0, "askSize": 0, "marketCap": 116243144704, "nonDilutedMarketCap": 115839773788, "fiftyTwoWeekLow": 4683.0, "fiftyTwoWeekHigh": 7225.0, "allTimeHigh": 9640.0, "allTimeLow": 52.15, "priceToSalesTrailing12Months": 1.9280988, "fiftyDayAverage": 5174.316, "twoHundredDayAverage": 5546.9165, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "INR",