{"info": {"address1": "Titagarh Towers", "address2": "756 Anandapur E.M. Bypass", "city": "Kolkata", "zip": "700107", "country": "India", "phone": "91 33 4019 0800", "fax": "91 33 4019 0823", "website": "https://www.titagarh.in", "industry": "Railroads", "industryKey": "railroads", "industryDisp": "Railroads", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Titagarh Rail Systems Limited engages in the manufacture and sale of freight and passenger rail systems in India and internationally. The company offers forged wheel set, loco shells, couplers, draft gears, cast bogies, and cast manganese steel crossing products; automobile-carrying, flat, hopper, tank, box, covered, and special purpose wagons; and brake vans. It also provides passenger rolling stock products, including high speed electric loco, electric multiple unit train sets, metros, semi high-speed trains, light rail transport, diesel electric multiple units, body shells, and bogies; and propulsion and electrical equipment, such as traction converters and power electronics, propulsion systems, auxiliary power supply products, electronic equipment, traction motors, train control and monitoring systems, and hardware and software products. In addition, the company offers maintenance, assistance and global, repair, inspection and refurbishing, systems and electrical equipment upgrade, exteriors and interiors face-lift, and power upgrading services. Further, it engages in the shipbuilding business comprising coastal research vessels, naval vessels, passenger ships, tugs, and inland water transport vessels. Additionally, the company manufactures modular panel bridges, bailey bridges, unibridges, and mati\u00e8re X bridges; and defense products, such as shelters, specialized wagons, EMI/EMS containers, CBRNe equipment, mine ploughs, pressure vessels, and specialized canopies. The company was formerly known as Titagarh Wagons Limited and changed its name to Titagarh Rail Systems Limited in May 2023. Titagarh Rail Systems Limited was incorporated in 1997 and is based in Kolkata, India.", "fullTimeEmployees": 1222, "companyOfficers": [{"maxAge": 1, "name": "Mr. Jagdish Prasad Chowdhary B.Com., MIMA", "age": 85, "title": "Executive Chairman", "yearBorn": 1940, "fiscalYear": 2025, "totalPay": 35700000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Umesh  Chowdhary B.Com.", "age": 51, "title": "Vice Chairman, MD & CEO", "yearBorn": 1974, "fiscalYear": 2025, "totalPay": 35700000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Saurav  Singhania", "age": 40, "title": "CFO, Group Finance Controller & Chief Risk Officer", "yearBorn": 1985, "fiscalYear": 2025, "totalPay": 9600000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Anil Kumar Agarwal B.Com. ACA, CWA", "age": 50, "title": "Deputy MD & Director", "yearBorn": 1975, "fiscalYear": 2025, "totalPay": 19400000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Prithish  Chowdhary", "age": 24, "title": "Deputy MD & Whole-Time Director", "yearBorn": 2001, "fiscalYear": 2025, "totalPay": 10200000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Aditya  Purohit", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Devendra Kumar Vyas ACA, B. COM.", "age": 56, "title": "Chief Executive Officer of Freight Rail Systems", "yearBorn": 1969, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Vijay  Subramanian", "title": "Chief Transformation Officer & CEO of Passenger Rail Systems", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "irWebsite": "http://www.titagarh.biz/financials.html", "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 757.3, "open": 770.95, "