{"info": {"address1": "BPK Star Tower", "address2": "4th Floor A.B. Road", "city": "Indore", "zip": "452008", "country": "India", "phone": "91 73 1478 0400", "website": "https://www.associatedalcohols.com", "industry": "Beverages - Wineries & Distilleries", "industryKey": "beverages-wineries-distilleries", "industryDisp": "Beverages - Wineries & Distilleries", "sector": "Consumer Defensive", "sectorKey": "consumer-defensive", "sectorDisp": "Consumer Defensive", "longBusinessSummary": "Associated Alcohols & Breweries Limited engages in liquor manufacturing, distillation, and bottling activities in India and internationally. It operates through two segments, Potable Alcohols and Ethanol. The company offers extra neutral alcohol, as well as Indian Made Indian Liquor and Indian Made Foreign Liquor. It also provides beer, spirits, wine, whiskey, vodka, rum, gin, tequila, and brandy, as well as grain-based ethanol. The company's brands include Central Province Whisky, Titanium Triple Distilled Vodka, Bombay Special Whisky, Desi Madira Masala, Superman Fine Whisky, James Mc Gill Whisky, and Jamaican Magic Rum; various franchise brands, such as Black and White Scotch Whiskey, Black Dog, Captain Morgan, Smirnoff, and VAT 69; and licensed brands, including Bagpiper Whisky, Blue Rigand Gin, Director Special, MC Dowell No. 1, and White Mischief Vodka. It serves household and commercial customers. The company was incorporated in 1989 and is based in Indore, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Anshuman  Kedia", "age": 32, "title": "CEO & Whole Time Director", "yearBorn": 1993, "fiscalYear": 2025, "totalPay": 32988000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Prasann Kumar Kedia", "age": 53, "title": "MD & Executive Director", "yearBorn": 1972, "fiscalYear": 2025, "totalPay": 57185000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Sangita  Kedia", "age": 60, "title": "Vice President of ESG", "yearBorn": 1