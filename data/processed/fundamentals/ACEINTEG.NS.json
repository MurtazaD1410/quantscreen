{"info": {"address1": "B-13, DSIDC Complex", "address2": "Functional Ind. Est Industrial Area Patparganj", "city": "New Delhi", "zip": "110092", "country": "India", "phone": "91 11 4953 7949", "website": "https://aceintegrated.com", "industry": "Staffing & Employment Services", "industryKey": "staffing-employment-services", "industryDisp": "Staffing & Employment Services", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Ace Integrated Solutions Limited, together with its subsidiary, Ace Prometric Solutions Private Limited, provides manpower recruitment and examination management services for government and semi-government organizations in India. It operates through Examination and Related IT Services; Printing and Paper Sales; and Specialty Chemicals segments. The company processes online/offline applications, conducts examinations, and processes examination results. It also offers recruitment management services; manpower recruitment and training services consisting of workforce planning, advertisement and application management, pre-employment screening, candidate profiling, psychometric and recruitment assessments, candidate management, and recruitment analysis support services; and examination management solutions comprising designing application, candidate authentication, result preparation, question paper management, examination conduction, result finalization, candidate support helpdesk, answer sheet scanning, and result handover services. In addition, the company trades in paper and specialty chemicals; and engages in the printing business. Further, it offers architecture, construction, and engineering services; mobile app development services for iOS and Android; and web development services, such as custom and CMS website development and e-commerce solutions. Additionally, the company imports and exports ink and primers for the furniture manufacturing industry. It serves the commission, defense, education, and PSU clientele. Ace Integrated Solutions Limited was incorporated in 1997 and is based in New Delhi, India.", "fullTimeEmployees": 9, "companyOfficers": [{"maxAge": 1, "name": "Mr. Chandra Shekhar Verma", "age": 63, "title": "Chairman & MD", "yearBorn": 1962, "fiscalYear": 2025, "totalPay": 3000000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajeev Ranjan Sarkari", "age": 67, "title": "CEO & Executive Director", "yearBorn": 1958, "fiscalYear": 2025, "totalPay": 800000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Amita  Verma", "age": 56, "title": "Whole-time Director", "yearBorn": 1969, "fiscalYear": 2025, "totalPay": 1800000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Shivani  Chandra", "age": 26, "title": "Executive Director", "yearBorn": 1999, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rohit  Goel", "title": "Chief Financial Officer", "fiscalYear": 2025, "totalPay": 606351, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Ankita  Sharma", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 20.09, "open": 20.44, "dayLow": 19.96, "dayHigh": 20.44, "regularMarketPreviousClose": 20.09, "regularMarketOpen": 20.44, "regularMarketDayLow": 19.96, "regularMarketDayHigh": 20.44, "payoutRatio": 0.0, "beta": 0.074, "volume": 417, "regularMarketVolume": 417, "averageVolume": 23146, "averageVolume10days": 4601, "averageDailyVolume10Day": 4601, "bid": 19.96, "ask": 19.97, "marketCap": 203591984, "nonDilutedMarketCap": 204918000, "fiftyTwoWeekLow": 14.2, "fiftyTwoWeekHigh": 29.94, "allTimeHigh": 82.3, "allTimeLow": 8.266666, "priceToSalesTrailing12Months": 9.425555, "fiftyDayAverage": 18.52, "twoHundredDayAverage": 21.34175, "trailingAnnua