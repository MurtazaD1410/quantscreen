{"info": {"address1": "State Bank Bhavan, Corporate Centre", "address2": "Madame Cama Road Nariman Point", "city": "Mumbai", "zip": "400021", "country": "India", "phone": "91 22 2274 0840", "website": "https://sbi.bank.in", "industry": "Banks - Regional", "industryKey": "banks-regional", "industryDisp": "Banks - Regional", "sector": "Financial Services", "sectorKey": "financial-services", "sectorDisp": "Financial Services", "longBusinessSummary": "State Bank of India provides banking products and services in India and internationally. It operates through the Treasury, Corporate/Wholesale Banking, Retail Banking, and Other Banking Business segments. The company offers personal banking products and services, including current, savings, salary, and deposit accounts; home, personal, pension, auto, education, and gold loans, as well as loans against insurance policies, property, and securities; debit, business debit, prepaid, and green remit cards; overdrafts; mutual funds, insurance, equity trading, portfolio investment schemes, remittance services; digital lending; and mobile, internet, and digital banking services. It also provides corporate banking products and services comprising corporate accounts, working capital and project finance, deferred payment guarantees, corporate term loans, structured finance, dealer and channel financing, equipment leasing, loan syndication, construction equipment loans, financing Indian firms' overseas subsidiaries or JVs, and cash management, as well as trade and service products. In addition, the company offers NRI services, including accounts, investments, loans, and remittances; agricultural banking services; and international banking services. Further, it provides life and general insurance; estate planning services; merchant banking and advisory; securities broking; trusteeship service; factoring; payment solution; asset management; portfolio and investment management; credit cards; and custody and fund accounting services. State Bank of India was founded in 1806 and is headquartered in Mumbai, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Rana Ashutosh Kumar Singh", "title": "MD of International Banking, Global Markets & Technology & Director", "fiscalYear": 2025, "totalPay": 3622654, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ashwini Kumar Tewari", "age": 58, "title": "MD of Corporate Banking (CAG & CCG) ]and Director", "yearBorn": 1967, "fiscalYear": 2025, "totalPay": 6340956, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rama Mohan Rao Amara", "title": "Managing Director of Retail Business & Operations & Director", "fiscalYear": 2025, "totalPay": 3066408, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Kameshwar Rao Kodavanti", "title": "Chief Financial Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Binod Kumar Mishra", "title": "Deputy MD & COO", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ravi  Ranjan", "title": "Managing Director of Risk, Compliance, & Stressed Assets Resolution Group (SARG)", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. G. S. Rana", "title": "Deputy MD of Human Resources & CDO", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sandeep  Tewari", "age": 63, "title": "Managing Director Corporate Banking & Subsidiaries", "yearBorn": 1962, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Ruma  Dey", "title": "Deputy MD  & Group Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ashok Kumar Sharma", "age": 59, "title": "DMD, CCO & Chief Sustainability Officer", "yearBorn": 1966, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "auditRisk": 6, "boardRisk": 9, "compensationRisk