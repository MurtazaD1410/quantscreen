{"info": {"address1": "Signature Tower III, Tower \u2018C\u2019", "address2": "5th Floor Sector 15-II, N.H-8 Near 32nd Avenue", "city": "Gurugram", "zip": "122001", "country": "India", "phone": "91 94 0409 8160", "website": "https://www.unistar.co.in", "industry": "Electrical Equipment & Parts", "industryKey": "electrical-equipment-parts", "industryDisp": "Electrical Equipment & Parts", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Universal Cables Limited manufactures and sells electrical and other cables, wires, conductors, accessories for cables and conductors, capacitors and capacitor banks, harmonic filters, and static VAR generators under the UNISTAR brand in India and internationally. The company offers XLPE cables, such as extra high voltage, medium voltage, low voltage, and aeriel bunched cables. It also provides PVC power and control cables; winding wires and flat motor leads; capacitors, including high and low-voltage capacitors, harmonic filters, surge protection/special duty capacitors, and automatic power factor correction panels; and elastomeric cables. In addition, the company offers engineering services for various industrial needs, such as turnkey contracts, system study, energy audit, harmonic analysis, and testing and commissioning of HT/LT capacitor banks and their associated equipment; and handling and installation services. It serves various sectors, including power sector, oil and petrochemical industries, mining industries, steel plants, cement plants, shipbuilding industry, offshore and onshore oil rigs, railways, defense sector, wind energy projects, heavy engineering industries, nuclear power plants, solar energy farms, and submarine cable applications, as well as EPC contractors, real estate developers, and overseas customers; and metallurgy, aerospace precision casting and machining, environment, oil and gas mineralogy, and agriculture industries. The company was incorporated in 1945 and is based in Gurugram, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Y. S. Lodha", "age": 61, "title": "CEO, MD & Additional Director", "yearBorn": 1964, "fiscalYear": 2025, "totalPay": 21743000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Tarun  Chugh", "age": 55, "title": "Chief Marketing Officer", "yearBorn": 1970, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Gopal  Agarwal", "title": "Chief Financial Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. S. C. Vaidya", "title": "Technical Advisor", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sanjeev  Dubey", "title": "Senior Vice President of Sales & EHV Operations", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ajit Kumar Goel", "title": "Sr. Vice President of Projects & Factory Manager of Satna", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ashok  Kumar Dager", "title": "Chief Security Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 1012.05, "open": 1100.0, "dayLow": 1071.0, "dayHigh": 1190.0, "regularMarketPreviousClose": 1012.05, "regularMarketOpen": 1100.0, "regularMarketDayLow": 1071.0, "regularMarketDayHigh": 1190.0, "dividendRate": 4.0, "dividendYield": 0.4, "exDividendDate": 1756944000, "payoutRatio": 0.0881, "fiveYearAvgDividendYield": 0.56, "trailingPE": 25.939568, "forwardPE": 79.145355, "volume": 1847199, "regularMarketVolume": 1847199, "averageVolume": 175153, "averageVolume10days": 158608, "averageDailyVolume10Day": 158608, "bid": 1174.0, "ask": 1175.85, "bidSize": 0, "askSize": 0, "marketCap": 40805236736, "nonDilutedMarketCap": 34938248667, "fiftyTwoWeekLow": 576.0, "fiftyTwoWeekH