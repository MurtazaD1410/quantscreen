{"info": {"address1": "One World Centre, Tower 1", "address2": "8th Floor 841, Senapati Bapat Marg Prabhadevi (West)", "city": "Mumbai", "zip": "400013", "country": "India", "phone": "91 22 2423 1999", "fax": "91 22 2423 1998", "website": "https://www.indusind.bank.in", "industry": "Banks - Regional", "industryKey": "banks-regional", "industryDisp": "Banks - Regional", "sector": "Financial Services", "sectorKey": "financial-services", "sectorDisp": "Financial Services", "longBusinessSummary": "IndusInd Bank Limited provides various banking products and financial services to individuals, corporations, government entities, and public sector undertakings in India. It operates in four segments: Treasury, Corporate/Wholesale Banking, Retail Banking, and Other Banking Operations. The company offers savings, salary, RFC, and uniformed personnel accounts; current accounts comprising smart, everyday, premium, trade, startup, and specialized accounts; fixed, recurring, sweep in/out, senior citizen fixed, NRE and NRO fixed, FCNR, and term deposits; vehicle, used and new car, two wheeler, home, gold, agri, personal, doctor professional, medical equipment, term, quick business, SME, and MSME loans; loans against property and securities; loans on credit card; and microfinance, working capital, and trade and export finance. It also provides debit, credit, prepaid, commercial, forex, duo, corporate, and business cards; life, health, and general insurance; safe deposit lockers; payment and financial inclusion products; foreign exchange services, including inward and outward remittances, and online forex portals; digital banking; and online vehicle auction services. In addition, the company offers mutual funds; bill payment; money transfer; NRI services; merchant solutions comprising POS terminal, payment gateway, digital rupee, and QR; transaction banking services, including trade finance, cash management, and tax payment; supply chain finance solutions, including supplier/vendor finance, channel finance, and receivable finance/factoring solutions; investment banking services consisting of debt syndication, debt and private equity fund-raising advisory, and M&A advisory; foreign exchange advisory; derivatives, such as currency, interest rate, and exchange-traded derivatives; debt capital markets, bullions, research, and online platforms; and correspondent and inclusive banking. IndusInd Bank Limited was incorporated in 1994 and is headquartered in Mumbai, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Rajiv Anand Prattipati", "age": 59, "title": "MD, CEO & Director", "yearBorn": 1966, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Viral  Damania", "title": "Chief Financial Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ravi  Pangal", "title": "Chief Information Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Anil Marco Rao", "title": "Chief Administrative Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Indrajit  Yadav", "title": "Head of Investor Relations & Strategy", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Anand  Vardhan", "title": "General Counsel", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sunil Kumar Singh", "title": "Chief Compliance Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Sheran  Mehra", "title": "Chief Marketing Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Amitabh Kumar Singh", "title": "Chief Human Resources Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Soumitra  Sen", "title": "Head of Consumer Banking & Marketing", "exercisedValue": 0, "unexercisedValue": 0}], "auditRisk": 10, "boardRisk": 1, "compensationRisk": 4, "shareHolderRightsRisk": 6, "overallRisk": 1, "governanceEpochDate": 1777593600, "executiveTeam": [], "maxAge":