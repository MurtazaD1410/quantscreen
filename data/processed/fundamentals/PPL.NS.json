{"info": {"address1": "Srivan", "address2": "Bijwasan", "city": "New Delhi", "zip": "110061", "country": "India", "phone": "91 11 4705 0555", "fax": "91 11 4115 5348", "website": "https://prakashplastics.in", "industry": "Building Products & Equipment", "industryKey": "building-products-equipment", "industryDisp": "Building Products & Equipment", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Prakash Pipes Limited manufactures and sells PVC pipes, fittings, and flexible packaging solutions in India and internationally. It offers uPVC pipes, casing pipes, plumbing uPVC pipes, soil waste rain (SWR) pipes, column pipes, agri pipes, garden pipes, water tanks, HDPE drums, and related fittings catering to applications in irrigation, drainage, housing, and sanitation. The company also provides flexible packaging products, including multilayer films and laminates, pouches, labels, blown PE films, rotogravure cylinders, and printing inks for packaging consumer goods, such as snacks, soaps, shampoos, food, beverages, oils, personal care, and pharmaceutical products. It offers its products under the Prakash brand name. Prakash Pipes Limited was founded in 1981 and is based in New Delhi, India.", "fullTimeEmployees": 519, "companyOfficers": [{"maxAge": 1, "name": "Mr. Kanha  Agarwal", "age": 34, "title": "MD, CEO & Director", "yearBorn": 1991, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Dalip Kumar Sharma", "title": "Chief Financial Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Jagdish  Chandra", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 194.43, "open": 198.9, "dayLow": 195.92, "dayHigh": 200.95, "regularMarketPreviousClose": 194.43, 