{"info": {"address1": "Plot No. 15", "address2": "Ground Floor Sector-44", "city": "Gurugram", "zip": "122003", "country": "India", "phone": "91 12 4423 5400", "fax": "91 12 4423 5402", "website": "https://www.southwestpinnacle.com", "industry": "Oil & Gas Equipment & Services", "industryKey": "oil-gas-equipment-services", "industryDisp": "Oil & Gas Equipment & Services", "sector": "Energy", "sectorKey": "energy", "sectorDisp": "Energy", "longBusinessSummary": "South West Pinnacle Exploration Limited, together with its subsidiaries, provides drilling, exploration, and allied services to coal, ferrous, nonferrous, atomic, and base metal mining; and water and unconventional energy industries in India and internationally. It operates through Drilling & Exploration; and Coal Mining and Trading segments. The company offers coal and mineral drilling services, such as wireline core drilling, reverse circulation drilling, large diameter drilling, and down\u0096the-hole drilling; and coalbed methane exploration and production drilling services. It also provides aquifer mapping services; geological and geophysical, workover rig, and 2D/3D seismic exploration services; geological field consultancy and allied services; and mining services for coal blocks and copper. In addition, the company offers infrastructure development and other related services. South West Pinnacle Exploration Limited was incorporated in 2006 and is based in Gurugram, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Vikas  Jain M.B.A.", "age": 50, "title": "Chairman & MD", "yearBorn": 1975, "fiscalYear": 2025, "totalPay": 12000000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Piyush  Jain", "age": 43, "title": "Joint MD & Whole Time Director", "yearBorn": 1982, "fiscalYear": 2025, "totalPay": 9000000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Dinesh  Agarwal", "age": 66, "title": "Chief Financial Officer", "yearBorn": 1959, "fiscalYear": 2025