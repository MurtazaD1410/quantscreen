{"info": {"address1": "RPG House", "address2": "463, Dr. Annie Besant Road Worli", "city": "Mumbai", "zip": "400030", "country": "India", "phone": "91 22 6667 0200", "fax": "91 22 6667 0287", "website": "https://www.kecrpg.com", "industry": "Engineering & Construction", "industryKey": "engineering-construction", "industryDisp": "Engineering & Construction", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "KEC International Limited engages in the engineering, procurement, and construction (EPC) business. It designs, manufactures, supplies, and erects transmission lines on turnkey basis; executes gas insulated transmission lines; undertakes EPC projects of high voltage electrical switching and distribution substations, as well as transmission lines in oil field areas; and turnkey solutions for railway contracts. The company also provides civil engineering solutions for transportation; urban infrastructure; industrial; residential and defense; commercial, public space, and datacenters; water; and international projects. In addition, it is involved in the provision of solar EPC services for large solar PV projects and PV solutions for industrial and commercial consumers; and design and engineering, project execution and management, bid management, and project feasibility analysis for large-scale solar photovoltaic power plants, as well as roof-top solar PV projects. Further, the company undertakes the construction of oil and gas / slurry pipelines and composite mechanical, civil, electrical, and instrumentation work in hydrocarbon facilities. The company manufactures and exports power cables, including EHV, HT and LV, telecom and optical fiber cables, control and instrumentation cables, and railway cables and conductors; special-purpose cables, such as cathodic protection, concentric, flat submersible, electric vehicle charging, hybrid, and green cables; and provides turnkey cabling solutions. KEC International Limited was founded in 1945 and is headquartered in Mumbai, India. KEC International Limited is a subsidiary of RPG Enterprises Limited.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Vimal  Kejriwal B.Com., D.T.M., F.C.A., F.C.S.", "age": 64, "title": "CEO, MD & Director", "yearBorn": 1961, "fiscalYear": 2025, "totalPay": 102400000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajeev  Agarwal", "title": "Chief Financial Officer", "fiscalYear": 2025, "totalPay": 48900000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Anand  Kulkarni", "title": "Executive Director of Business Operations", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Suraj Prakash Eksambekar", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Somraj  Roy", "title": "Chief Human Resources Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Nagesh  Veeturi", "title": "Executive Director of Civil", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Mayank  Agrawal", "title": "Chief Executive of Oil & Gas Pipelines", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ganesh  Srinivasan", "title": "President of T&D", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Prateek  Bhattacharya", "title": "Managing Director of KEC Asian Cables Ltd.", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ankur  Dev", "title": "Executive Director of Transportation", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 485.05, "open": 491.6, "dayLow": 490.0, "dayHigh": 508.5, "regularMarketPrevio