{"info": {"address1": "TICEL BIO PARK", "address2": "6th floor Module No. 601, 602, 603, Phase II CSIR Road Taramani", "city": "Chennai", "zip": "600113", "country": "India", "phone": "91 44 4344 6700", "fax": "91 44 4740 6190", "website": "https://www.solara.co.in", "industry": "Drug Manufacturers - Specialty & Generic", "industryKey": "drug-manufacturers-specialty-generic", "industryDisp": "Drug Manufacturers - Specialty & Generic", "sector": "Healthcare", "sectorKey": "healthcare", "sectorDisp": "Healthcare", "longBusinessSummary": "Solara Active Pharma Sciences Limited manufactures, produces, processes, formulates, sells, imports, exports, merchandises, distributes, trades in, and deals in active pharmaceutical ingredients (API) in India, Asia Pacific, Europe, North America, South America, and internationally. The company offers APIs for amyotrophic lateral sclerosis, anesthetics, anthelmintic, anti hyperlipidemic, anti-arrhythmic agent, anti-asthmatic, anti-hypertensive, anti-inflammatory, anti-Parkinson, anti-retroviral, antibiotic, anticonvulsant, antidepressant, antifibrinolytics, antigout agent, antihelmintic, antihistamine, antihyperlipoproteinemic, antimycotic, antifungal, antineoplastic detoxifying agent, antiprotozoal agent, antipsoriatic, antipsychotic, antitubercular, antiulcer, antiulcerative, anxiolytic, aprepitant, bile acid analogue, calcimimetic agent, cardiovascular agent, chronic alcoholism, treatment of hyperphosphatemia, hemorrheologic agent, hypercholesterolemia, hypophosphatemic agent, immune-suppressant, loop diuretic, NSAIDs, anti-hyperkalaemia, nucleoside inhibitor, OAB treatment, phenylalanine reducer, phosphate binder, reversal of neuro-muscular blocking agent, skeletal muscle relaxant, and topical anti-infectives. It also provides contract research and manufacturing services for APIs, including contract development and manufacturing, analytical development, impurity synthesis, and regulatory support. In addition, the company exports its products. The company was formerly known as SSL Pharma Sciences Limited and changed its name to Solara Active Pharma Sciences Limited in March 2017. Solara Active Pharma Sciences Limited was incorporated in 2017 and is based in Chennai, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Sandeep Shashikantha Rao M.Sc., PGDM", "age": 52, "title": "CEO & MD", "yearBorn": 1973, "fiscalYear": 2025, "totalPay": 32557000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Arun Kumar Pillai B.Com.", "age": 64, "title": "Founder & Non-Executive Director", "yearBorn": 1961, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sarat  Kumar", "title": "Chief Financial Officer & Chief Investor Relations Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Vishal  Mathur", "title": "Chief Commercial Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Raghavan  Venkatramani", "title": "General Manager of Accounts", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Hero  Velladurai", "title": "Chief Scientific Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Pooja Jaya Kumar", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Mohanraj  S", "title": "Whole-Time Director & Chief Human Resources Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. V. Sundara Moorthy", "title": "Chief Quality Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajesh  Patro", "title": "Chief Risk Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHi