{"info": {"address1": "# 1-7-27 to 34, Shyam Towers", "address2": "2nd Floor United Building Complex Sarojini Devi Road", "city": "Secunderabad", "zip": "500003", "country": "India", "phone": "91 40 2781 7440", "fax": "91 40 2781 2569", "website": "https://www.cubextubings.com", "industry": "Copper", "industryKey": "copper", "industryDisp": "Copper", "sector": "Basic Materials", "sectorKey": "basic-materials", "sectorDisp": "Basic Materials", "longBusinessSummary": "Cubex Tubings Limited manufactures and sells copper and copper based alloy products in India and internationally. It offers copper products, such as DLP, DHP, ETP, and medical gas copper tubes; copper round and bus bars; and copper wires and profiles. The company also provides copper alloy products, including admiralty brass and aluminum brass tubes, as well as copper nickel tubes. In addition, it offers copper-nickel fittings and flanges, along with nickel-copper alloy tubes. The company serves the offshore, desalination, defense, chemical, power generation, electrical equipment, ship building, automobile, HVAC, and marine industries, as well as manufacturers of power plants, switchgears, refineries, furnace manufacturers, and sugar and nuclear plants. Cubex Tubings Limited was incorporated in 1979 and is based in Secunderabad, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Virendra Kumar Bhandari", "age": 53, "title": "MD, CEO & Director", "yearBorn": 1972, "fiscalYear": 2025, "totalPay": 900000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Siva Prasad Sarva", "title": "Chief Financial Officer", "fiscalYear": 2025, "totalPay": 240000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Veena  Bhandari", "age": 50, "title": "Director of Administration & Executive Director", "yearBorn": 1975, "fiscalYear": 2025, "totalPay": 600000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Chandni K. Moolchandani", "title": "Company Sec