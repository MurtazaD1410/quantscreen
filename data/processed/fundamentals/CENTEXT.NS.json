{"info": {"address1": "\u2018N\u2019 Block", "address2": "2nd Floor 113, Park Street", "city": "Kolkata", "zip": "700016", "country": "India", "phone": "91 33 2229 1012", "fax": "91 33 2249 5656", "website": "https://www.centuryextrusions.com", "industry": "Aluminum", "industryKey": "aluminum", "industryDisp": "Aluminum", "sector": "Basic Materials", "sectorKey": "basic-materials", "sectorDisp": "Basic Materials", "longBusinessSummary": "Century Extrusions Limited manufactures and sells aluminum extrusion products in India. The company operates through two segments, Manufacturing of Aluminum Extruded Products; and Manufacturing of Transmission and Distribution Line. The company offers profiles for architectural applications, such as building systems, structural glazing, curtain walls, aluminum rolling shutters, windows, doors, partitions, false ceilings, tower bolts, handrails, door handles, hinges, drapery rods, and modular furniture; aluminum form works; road transport sections; rail coach windows and doors; automobile components; and heat transfer in electronics and electrical gadgets. It also provides profiles for electrical applications, including tubes and flats for bus bars; transmission line hardware, such as P.G. clamps; and H-connectors, repair sleeves, lugs, and solar panels. In addition, the company offers profiles for engineering applications consisting of motor housings, gear pump casings, ferrules, A.C. louvers, machinery parts, elevators, pneumatic actuators and cylinders, and valve bodies; and various defense applications and others. Additionally, it offers extruded and cold-drawn round bars and hexagonal bars for various engineering applications; and extruded and cold drawn rods and wires in coil form for use in armor rods, lamp pin stock, metallizing wire, rivet stock, welding filler wire, etc. Further, the company manufactures power transmission and distribution hardware. It markets its products under the Century brand. Century Extrusions Limited was incorporated in 1988 and is headquartered in Kolkata, India.", "fullTimeEmployees": 346, "companyOfficers": [{"maxAge": 1, "name": "Mr. Shivanshu  Jhunjhunwala", "age": 32, "title": "MD & Executive Chairman", "yearBorn": 1993, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. G. V. Khedkar", "title": "President", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Nitesh Kumar Kyal", "age": 38, "title": "Chief Financial Officer", "yearBorn": 1987, "fiscalYear": 2021, "totalPay": 945670, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajan  Singh", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2021, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1640908800, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 20.13, "open": 20.2, "dayLow": 19.91, "dayHigh": 20.6, "regularMarketPreviousClose": 20.13, "regularMarketOpen": 20.2, "regularMarketDayLow": 19.91, "regularMarketDayHigh": 20.6, "exDividendDate": 1279756800, "payoutRatio": 0.0, "beta": 0.211, "trailingPE": 15.413533, "volume": 56543, "regularMarketVolume": 56543, "averageVolume": 146881, "averageVolume10days": 93382, "averageDailyVolume10Day": 93382, "bid": 20.48, "ask": 20.49, "bidSize": 0, "askSize": 0, "marketCap": 1640000000, "nonDilutedMarketCap": 1600000000, "fiftyTwoWeekLow": 15.67, "fiftyTwoWeekHigh": 34.75, "allTimeHigh": 34.75, "allTimeLow": 0.37, "priceToSalesTrailing12Months": 0.35954663, "fiftyDayAverage": 19.9852, "twoHundredDayAverage": 22.8661, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "INR", "tradeable": false, "enterpriseValue": 2039683328, "profitMargins": 0.023440002, "floatShares": 45650027, "sharesOutstanding": 80000000, "heldPercentInsiders": 0.52623004, "heldPercentInstitutions": 0.0, "impliedSharesOutstanding": 80000000, "bookValue": 11.154, "priceToBook": 1.8379056, "lastFiscalYearEnd": 1743379200, "nextFiscalY