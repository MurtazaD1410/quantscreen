{"info": {"address1": "1101, Crescenzo, G-block", "address2": "11th Floor Opposite MCA Club, Bandra Kurla Complex Bandra (East)", "city": "Mumbai", "zip": "400051", "country": "India", "phone": "91 22 6740 6300", "fax": "91 22 6740 6514", "website": "https://www.borosil.com", "industry": "Furnishings, Fixtures & Appliances", "industryKey": "furnishings-fixtures-appliances", "industryDisp": "Furnishings, Fixtures & Appliances", "sector": "Consumer Cyclical", "sectorKey": "consumer-cyclical", "sectorDisp": "Consumer Cyclical", "longBusinessSummary": "Borosil Limited manufactures, sells, and trades in consumer ware products in India. The company offers Scientific and Industrial Products, including laboratory glassware, instruments, disposable plastics, liquid handling systems, explosion proof lighting glassware, glass ampoules, tabular glass vials, and pharmaceutical packaging. It also provides consumer products, such as glass serve wear products, microwavable and flameproof kitchenware, glass tumblers, hydra bottles, tableware and dinnerware, storage products, kitchen appliances, glass lunch boxes, stainless steel cookware, and steel vacuum insulated flasks and bottles, as well as solar glass. The companoffers its products under the Larah, Klass Pack, LabQuest, and Borosil brand names. The company distributes through mom-and-pop crockery stores, large retail formats, e-commerce platforms, and website. It also exports its products. The company was formerly known as Hopewell Tableware Limited. The company was founded in 1962 and is based in Mumbai, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Shreevar  Kheruka", "age": 43, "title": "MD, CEO & Vice Chairman of the Board", "yearBorn": 1982, "fiscalYear": 2025, "totalPay": 155027000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Anand Mahendra Sultania", "title": "Chief Financial Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajesh