{"info": {"address1": "G-II, Dalamal House", "address2": "Ground Floor Nariman Point", "city": "Mumbai", "zip": "400021", "country": "India", "phone": "91 22 4076 7373", "fax": "91 22 4076 7377", "website": "https://www.kslindia.com", "industry": "Capital Markets", "industryKey": "capital-markets", "industryDisp": "Capital Markets", "sector": "Financial Services", "sectorKey": "financial-services", "sectorDisp": "Financial Services", "longBusinessSummary": "Khandwala Securities Limited provides stock broking, investment banking, portfolio management, and research analyst and investment advisory services in India. It operates in two segments, Fee-Based and Investment/Trading in Stock. The company offers investment banking services, including capital raising, mergers and acquisitions advisory, domestic IPOs, FCCBs, private equity placements, corporate finance advisory, restructuring, FCCBs, and GDRs; institutional equities services, such as institutional equity sales, execution, and research; and broking and distribution services comprising non-institutional equity sales, trading, research, depository participant ship, and broking and distribution. It also provides investment advisory services, including private and corporate wealth management; and portfolio management services, such as planning and asset deployment advice, and asset allocation and distribution of various products. In addition, the company is involved in the provision of financial advisory services related to equity and debt issue management, and portfolio management and broking; trading, investing and speculation activities in capital markets; and mobile and browser based online trading applications under the KSL EazyTrade, KSL Prive, and KSL EazyWealth Browser brand. Further, it provides equity, derivatives, mutual funds, structured products, depository, and insurance products, as well as third party product distribution services. The company serves public and private sector corporations, multinational corporations, financial institutions, institutional investors, high net worth individuals, and retail investors, as well as market intermediaries. Khandwala Securities Limited was founded in 1934 and is headquartered in Mumbai, India.", "fullTimeEmployees": 44, "companyOfficers": [{"maxAge": 1, "name": "Mr. Paresh Jayantilal Khandwala", "age": 70, "title": "MD, Chief Investor Relations Officer & Director", "yearBorn": 1955, "fiscalYear": 2025, "totalPay": 3125000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Pranav Paresh Khandwala", "age": 45, "title": "CFO & Whole-time Director", "yearBorn": 1980, "fiscalYear": 2025, "totalPay": 1800000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Abhishek Narendra Joshi", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "totalPay": 536250, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Amol  Wahikar", "title": "Chief Dealer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 17.51, "open": 17.0, "dayLow": 16.7, "dayHigh": 17.5, "regularMarketPreviousClose": 17.51, "regularMarketOpen": 17.0, "regularMarketDayLow": 16.7, "regularMarketDayHigh": 17.5, "payoutRatio": 0.0, "beta": 0.559, "volume": 642, "regularMarketVolume": 642, "averageVolume": 6154, "averageVolume10days": 3441, "averageDailyVolume10Day": 3441, "bid": 17.08, "ask": 17.5, "bidSize": 0, "askSize": 0, "marketCap": 266941584, "nonDilutedMarketCap": 284636001, "fiftyTwoWeekLow": 12.2, "fiftyTwoWeekHigh": 29.0, "allTimeHigh": 133.0, "allTimeLow": 5.0, "priceToSalesTrailing12Months": 8.367115, "fiftyDayAverage": 16.1044, "twoHundredDayAverage": 20.25855, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "INR", "tradeable": false, "enterpriseValue": 290770336, "profitMargins": -0.90413004, "floatShares": 3121585