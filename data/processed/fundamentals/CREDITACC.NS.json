{"info": {"address1": "New No. 49 (Old No725) 46th Cross", "address2": "8th Block Jayanagar Next to Rajalakshmi Kalyana Mantap", "city": "Bengaluru", "zip": "560070", "country": "India", "phone": "91 80 2263 7300", "fax": "91 80 2664 3433", "website": "https://www.creditaccessgrameen.in", "industry": "Credit Services", "industryKey": "credit-services", "industryDisp": "Credit Services", "sector": "Financial Services", "sectorKey": "financial-services", "sectorDisp": "Financial Services", "longBusinessSummary": "CreditAccess Grameen Limited, a non-banking financial company, provides micro finance services for women from poor and low-income households in India. The company offers microcredit loans for income generation, home improvement, emergency, family welfare, and Grameen Unnati, as well as Grameen Suraksha, Grameen Sanchay, life insurance, and national pension schemes. It also provides retail finance loans, such as Grameen Vikas, Unnati loan, Grameen two-wheeler, and Grameen housing loan. In addition, the company offers digital lending products comprising Grameen Mahi, a customer app, Pragathi digital and multi-purpose digital loans. The company was formerly known as Grameen Koota Financial Services Private Limited and changed its name to CreditAccess Grameen Limited in January 2018. CreditAccess Grameen Limited was incorporated in 1991 and is headquartered in Bengaluru, India. CreditAccess Grameen Limited is a subsidiary of CreditAccess India BV.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Ganesh  Narayanan", "age": 49, "title": "MD, CEO & Director", "yearBorn": 1976, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Nilesh Shrikrishna Dalvi CFA, FRM", "age": 41, "title": "Chief Financial Officer and Head of Investor Relations & ESG", "yearBorn": 1984, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Gururaj Kumar Kumar KS Rao", "age": 50, "title": "Chief Operating Officer", "yearBorn": 1975, "exercisedValue": 0,