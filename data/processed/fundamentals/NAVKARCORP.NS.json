{"info": {"address1": "Tower-1", "address2": "09th Floor, C-Wing, Seawoods Grand Central, Plot No. R-1 Sector-40, Seawood Darawe", "city": "Navi Mumbai", "zip": "400706", "country": "India", "phone": "91 22 4800 6500", "fax": "91 22 4800 6509", "website": "https://www.navkarcorp.com", "industry": "Integrated Freight & Logistics", "industryKey": "integrated-freight-logistics", "industryDisp": "Integrated Freight & Logistics", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Navkar Corporation Limited provides container freight station, inland container depot, rail terminal, container train operator, and warehousing and other logistics solutions in India. It operates private freight terminals, which are used for handling various types of cargo trains for steel cargo, bulk cargo, bagged cargo, containerized cargo, and automobiles; and railway terminals that are used for handling export rakes of agro products, domestic rakes, and container rakes. The company also provides customs clearance services; cargo and container services, including parking and repair facilities; and multi modal transportation, storage yard for empty and laden containers, and storage and handling various types of cargo from bulk, block, palletized, liquid, hazardous, and reefer cargos. In addition, it offers bonded and domestic warehousing services; handling and stuffing facilities, and storage options; handling and consolidation of export cargo; value-added services, such as sorting, barcoding, shrink wrapping, and palletizing; and EDI linkage for custom clearance. Further, the company provides maintenance and repair (MnR) and empty containers depot services for various containers as per the requirements of shipping lines, as well as equipment, which includes RTG crane, fire engine, bulk containers, trailers, hydra cranes, hywa, forklifts, tankers, reach stackers, owned rakes, locomotives, and rail tracks. The company was founded in 2006 and is based in Navi Mumbai, India. Navkar Corporation Limited is a subsidiary of JSW Port Logistics Private Limited.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Sabyasachi  Mukherjee", "title": "Chief Financial Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Deepa  Gehani", "title": "Company Secretary & Compliance Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Amit  Garg", "title": "Whole-Time Director", "fiscalYear": 2025, "totalPay": 11008000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Mahesh  Adapa", "title": "Chief Operating Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 94.88, "open": 95.4, "dayLow": 95.0, "dayHigh": 98.7, "regularMarketPreviousClose": 94.88, "regularMarketOpen": 95.4, "regularMarketDayLow": 95.0, "regularMarketDayHigh": 98.7, "payoutRatio": 0.0, "beta": 0.383, "trailingPE": 48.535, "forwardPE": 7.685669, "volume": 392115, "regularMarketVolume": 392115, "averageVolume": 654833, "averageVolume10days": 357653, "averageDailyVolume10Day": 357653, "bid": 96.9, "ask": 97.09, "bidSize": 0, "askSize": 0, "marketCap": 14610896896, "nonDilutedMarketCap": 14281259893, "fiftyTwoWeekLow": 74.05, "fiftyTwoWeekHigh": 140.2, "allTimeHigh": 247.0, "allTimeLow": 13.1, "priceToSalesTrailing12Months": 2.1157382, "fiftyDayAverage": 93.6612, "twoHundredDayAverage": 104.3316, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "INR", "tradeable": false, "enterpriseValue": 15842235392, "profitMargins": 0.043649998, "floatShares": 44425089, "sharesOutstanding": 150519181, "heldPercentInsiders": 0.71692, "heldPercentInstitutions": 0.01784, "impliedSharesOutstanding": 150519181, "bookValue": 130.236, "priceToBook": 0.7453393, "lastFiscalYearEnd": 1774915200, "nextFiscalYearEnd": 1806451200, "mostRecent