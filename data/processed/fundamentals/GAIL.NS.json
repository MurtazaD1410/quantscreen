{"info": {"address1": "GAIL Bhawan", "address2": "16 Bhikaji Cama Place R K Puram", "city": "New Delhi", "zip": "110066", "country": "India", "phone": "91 11 2618 2955", "fax": "91 11 2618 5941", "website": "https://www.gailonline.com", "industry": "Utilities - Regulated Gas", "industryKey": "utilities-regulated-gas", "industryDisp": "Utilities - Regulated Gas", "sector": "Utilities", "sectorKey": "utilities", "sectorDisp": "Utilities", "longBusinessSummary": "GAIL (India) Limited operates as a natural gas processing and distribution company in India and internationally. It operates through Transmission Services, Natural Gas Marketing, Petrochemicals, LPG and Other Liquid Hydrocarbons, and Other segments. The company is involved in the transmission and marketing of natural gas through pipelines to the power, fertilizer, industrial, automotive, petrochemical, domestic, and commercial sectors; exploration and production activities; and marketing of compressed biogas, city gas, and biofuels. It also produces and markets liquefied petroleum gas (LPG), propane, pentane, naphtha, mixed fuel oil, ethylene, propylene, and polypropylene; and manufactures petrochemicals, such as high-density and linear low-density polyethylene under the G-Lex and G-Lene brands. In addition, the company generates wind and solar power. GAIL (India) Limited was incorporated in 1984 and is based in New Delhi, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Deepak  Gupta", "age": 55, "title": "Chairman, MD & Director of Projects", "yearBorn": 1970, "fiscalYear": 2025, "totalPay": 10846000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rakesh Kumar Jain", "age": 59, "title": "CFO, Director of Finance & Additional Director", "yearBorn": 1966, "fiscalYear": 2025, "totalPay": 11110000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sanjay  Kumar", "age": 58, "title": "Director of Marketing & Executive Director", "yearBorn": 1967, "fiscalYear":