{"info": {"address1": "Aurum Q1", "address2": "Aurum Q Parc Thane Belapur Road", "city": "Navi Mumbai", "zip": "400710", "country": "India", "phone": "91 22 6911 1800", "fax": "91 22 2778 1320", "website": "https://www.aurumproptech.in", "industry": "Real Estate Services", "industryKey": "real-estate-services", "industryDisp": "Real Estate Services", "sector": "Real Estate", "sectorKey": "real-estate", "sectorDisp": "Real Estate", "longBusinessSummary": "Aurum PropTech Limited engages in the business of software development for real estate and other services in India. It operates through Rental, Distribution, Capital, and Others segments. The company provides HelloWorld, a co-living platform for students and young professionals; Nestaway, a home rental platform that offers residences in prime urban neighborhoods; and MonkSpaces.Ai, which enables real estate businesses to monetize, manage, and maintain their rental portfolios. It also offers Aurum Analytica that delivers end-to-end solutions for the real estate lifecycle; Sell.do, a customer relationship management for real estate; Integrow Asset Management, provides technology-driven investment solutions spanning institutional-grade residential and commercial real estate; PropTech Pulse, a knowledge and lead-generation hub for the real estate; and Aurum KuberX, a home loan aggregation and SaaS platform that empowers real estate buyers to search and apply for home loans. In addition, the company provides marketing automation, sales automation, and transaction management solutions, as well as TheHouseMonk and TheOfficeMonk, which offers property management solutions. The company was formerly known as Majesco Limited and changed its name to Aurum PropTech Limited in October 2021. Aurum PropTech Limited was incorporated in 2013 and is based in Navi Mumbai, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Onkar Sunil Shetye", "age": 40, "title": "Executive Whole-Time Director", "yearBorn": 1985, "fiscalYear": 2025, "totalPay": 6906900, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Kunal  Karan", "title": "Chief Financial Officer", "fiscalYear": 2025, "totalPay": 8200000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ravi  Krishnan", "title": "Chief Technology Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Diwakar  Pingle", "title": "Head of Investor Relations", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Pranali Pratap Desale", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Prateek Kumar Solanki", "age": 49, "title": "Executive Vice President of Global Sales", "yearBorn": 1976, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Denise  Garth", "title": "Chief Strategy Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Himanshu  Thosar", "title": "Chief Digital Transformation Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ismail  Khan", "title": "COO of Hello world Technologies", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Shrikant  Jagtap", "title": "Deputy Chief Financial Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 179.49, "open": 180.88, "dayLow": 178.36, "dayHigh": 181.9, "regularMarketPreviousClose": 179.49, "regularMarketOpen": 180.88, "regularMarketDayLow": 178.36, "regularMarketDayHigh": 181.9, "exDividendDate": 1608681600, "payoutRatio": 0.0, "beta": 0.035, "trailingPE": 715.04, "forwardPE": 44.69, "volume": 48748, "regularMarketVolume": 48748, "averageVolume": 109724, "averageVolume10days": 