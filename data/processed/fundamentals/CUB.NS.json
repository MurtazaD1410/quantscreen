{"info": {"address1": "Narayana", "address2": "No. 24-B, Gandhi Nagar", "city": "Kumbakonam", "zip": "612001", "country": "India", "phone": "91 43 5240 2322", "fax": "91 43 5243 1746", "website": "https://cityunionbank.bank.in", "industry": "Banks - Regional", "industryKey": "banks-regional", "industryDisp": "Banks - Regional", "sector": "Financial Services", "sectorKey": "financial-services", "sectorDisp": "Financial Services", "longBusinessSummary": "City Union Bank Limited provides various banking products and services in India. It operates in four segments: Treasury, Corporate/Wholesale Banking, Retail Banking, and Other Banking Operations. The company offers savings, current, staff salary, and resident foreign currency accounts; fixed, recurring, flexifix, and income tax saver deposits; personal and agricultural gold, personal, consumer, home/housing, property, education, working capital, business, and foreign currency loans, as well as loan against property, gold-based overdraft, cash credits, bill finance, bank guarantee, and letter of credit; international business services, including export, import, fx retail, remittance, correspondent banking, and treasury risk management services; sovereign gold bond; debit, prepaid, and credit cards; NRI banking products and services; and insurance products comprising life, health, and general insurance products, as well as social security schemes. It also provides tech products and services, such as net/online and mobile banking; cash and wealth management; electronic fund transfer; green pins; wallet; point of sale; and automated teller machines, as well as demat, bill payment, GST and TAX payments, and digital signature services. In addition, the company offers payments to government, including online taxes and electricity bill payment; agri related information, academic, and kiosk services; and support services, such as safe deposit locker facilities, value added, 24/7 customer care, and account aggregator. The company was formerly known as The Kumbakonam City Union Bank Limited and changed its name to City Union Bank Limited in December 1987. City Union Bank Limited was incorporated in 1904 and is based in Kumbakonam, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Vijay Anandh Ramamoorthy B.Sc., M.B.A.", "age": 50, "title": "MD, CEO & Whole-time Executive Director", "yearBorn": 1975, "fiscalYear": 2025, "totalPay": 19650549, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Venkataraman  Ramesh A.C.S., M.Sc.", "age": 62, "title": "Whole-time Executive Director", "yearBorn": 1963, "fiscalYear": 2025, "totalPay": 6467720, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. J.  Sadagopan", "title": "Deputy GM of Taxation & CFO", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. K.  Jayaraman", "age": 51, "title": "Chief Compliance Officer & GM", "yearBorn": 1974, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. V.  Gopalakrishnan B.A., M.B.A.", "age": 53, "title": "General Manager of HRMD and BD / P&D", "yearBorn": 1972, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Venkatakrishnan  S B.Com., C.A., C.M.A.", "title": "Chief Risk Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "SVSS  Janakiram", "title": "Deputy Head of Internal Audit & Deputy GM", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. V.  Venkat Kishna", "title": "Head of Internal Audit & GM", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. S.  Venkataramanan", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 248.55, "open": 251.8,