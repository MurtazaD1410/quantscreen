{"info": {"address1": "33/1, Mount Road", "address2": "Sadar", "city": "Nagpur", "zip": "440001", "country": "India", "phone": "91 71 2252 4661", "fax": "91 71 2252 0360", "website": "https://www.sunflagsteel.com", "industry": "Steel", "industryKey": "steel", "industryDisp": "Steel", "sector": "Basic Materials", "sectorKey": "basic-materials", "sectorDisp": "Basic Materials", "longBusinessSummary": "Sunflag Iron and Steel Company Limited manufactures and sells steel rolled products in India and internationally. The company offers super alloys, tool steels, SSR 550, spring steels, free cutting steels, forging steels, forging ingots, microalloyed steels, engine value steels, cold forging steels, and bearing steels. It also provides flat steel, round bars and coils, rolled bars and wires, round cornered squares, and hexagonal steel products. The company's products are used for automobile, general engineering, machinery, projects, railway, defence, and construction applications. It exports its products to South East Asian, North American and South American Countries, South Africa, the European Union, Japan, Taiwan, Australia, Switzerland, the United Kingdom, and Ireland. Sunflag Iron and Steel Company Limited was incorporated in 1984 and is headquartered in Nagpur, India.", "fullTimeEmployees": 1250, "companyOfficers": [{"maxAge": 1, "name": "Mr. S. Mahadevan Iyer", "age": 59, "title": "Chief Financial Officer", "yearBorn": 1966, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ramchandra Vasant Dalvi B.Tech", "age": 75, "title": "Whole-time Director & Director of Technical", "yearBorn": 1950, "fiscalYear": 2025, "totalPay": 13840702, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Pranav Ravi Bhardwaj", "age": 51, "title": "MD & Executive Director", "yearBorn": 1974, "fiscalYear": 2025, "totalPay": 53383213, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. D. S. Kalne", "age": 69, "title": "Vice Pres