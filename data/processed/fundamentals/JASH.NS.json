{"info": {"address1": "31, Industrial Area", "address2": "Sector C Sanwer Road", "city": "Indore", "zip": "452015", "country": "India", "phone": "91 73 1272 0143", "website": "https://www.jashindia.com", "industry": "Specialty Industrial Machinery", "industryKey": "specialty-industrial-machinery", "industryDisp": "Specialty Industrial Machinery", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Jash Engineering Limited manufactures, trades in, and sells various engineering products for general engineering, water and wastewater, power plant, and bulk solids handling industries in India and internationally. The company offers water control gates, such as slide/penstock, open channel, weir, and flap gates, as well as stop logs; heavy fabricated gates, including bulkhead, rollers, crest, butterfly, radial/tainter, bonneted, tilting weir, swing, and mitre gates; and screening equipment comprising manual bar, trash rack with flat bars, trash rack with wire mesh, J-type trash rack, suspended grab trash rake, multi-rake bar, step, pre-scalators, travelling band, drum, and static screens. It also provides jet breaker and screw conveyor wash compactors, and flat belt conveyors; unidirectional values and bidirectional valves; water hammer control devices, such as zero velocity, vacuum breaker air cushion, and energy dissipating valves, as well as air vessels/surge vessels compressor type and bladder type; archimedean crew pumps; and hydro power equipment. In addition, the company offers agitators, clarifiers, clariflocculators, detritors, surface aerotors, and thickeners; disc filters; and bulk solids handling valves, including slide gate, swing gate, double flap, casted square port, and fabricated valves. Its products are used in raw water and sea water intake systems, water and waste water pumping stations and treatment plants, storm water pumping stations, flood prevention and mitigation schemes, water transmission lines and also for power, steel, cement, paper and pulp, petrochemicals, chemical, and fertilizers and other process plants. The company was founded in 1948 and is headquartered in Indore, India.", "fullTimeEmployees": 617, "companyOfficers": [{"maxAge": 1, "name": "Mr. Pratik  Patel", "age": 61, "title": "MD & Chairman", "yearBorn": 1964, "fiscalYear": 2025, "totalPay": 17702325, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Dharmendra  Jain", "title": "Chief Financial Officer", "fiscalYear": 2025, "totalPay": 7964000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Tushar  Kharpade", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "totalPay": 1933000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Suresh Kumar Patel", "age": 82, "title": "Executive Director", "yearBorn": 1943, "fiscalYear": 2025, "totalPay": 6016454, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Bhuvanesh  Pandey", "title": "Chief Operating Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ashok Kumar Jain", "title": "Head of Human Resource & Administration", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "H.N.  Nagaraj", "age": 75, "title": "Assistant Vice President of Marketing", "yearBorn": 1950, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Bhuvanesh  Chandra", "age": 47, "title": "Vice President of Operation", "yearBorn": 1978, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Durgesh Kumar Tiwari", "age": 57, "title": "Senior General Manager of Design & Development", "yearBorn": 1968, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 399.25, "open": 394.0, "dayLow": 394.0, "day