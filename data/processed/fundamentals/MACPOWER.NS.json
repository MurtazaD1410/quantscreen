{"info": {"address1": "Plot No. 2234", "address2": "Near Kranti Gate GIDC Metoda Talu-Lodhika", "city": "Rajkot", "zip": "360021", "country": "India", "phone": "91 28 2728 7930", "fax": "91 28 2728 7933", "website": "https://macpowercnc.com", "industry": "Specialty Industrial Machinery", "industryKey": "specialty-industrial-machinery", "industryDisp": "Specialty Industrial Machinery", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Macpower CNC Machines Limited manufactures and sells computer numerical control (CNC) metal cutting machines in India. It offers CNC turning centers for the bearing, valve, pump, tool room, automobile, process plant components, agriculture, textile, and piping industries; and vertical machining centers (VMCs) for tool rooms, die and molds, automobile, pattern, defence, power, and railways. The company also provides turn mill centers for special purpose components, aeronautics, defence, agriculture, and medical applications; and vertical turret lathe for valve and motor bodies, engine liners, and railways. In addition, it offers horizontal machining centers for automobile, die and mold, defence, aeronautics, textile, medical, and railways; drill tap centers for the electronics, automobile, and textile industries; twin head VMCs for the automobile and textile industries with robotic automation solutions; and cylindrical grinders, as well as twin spindle turning centers and double column machine. Macpower CNC Machines Limited was incorporated in 2003 and is based in Rajkot, India.", "fullTimeEmployees": 850, "companyOfficers": [{"maxAge": 1, "name": "Mr. Rupesh Kumar Jagdishchandra Mehta", "age": 57, "title": "Chairman & MD", "yearBorn": 1968, "fiscalYear": 2025, "totalPay": 3600000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Nikesh Jagdishchandra Mehta", "age": 47, "title": "CEO & Whole-Time Director", "yearBorn": 1978, "fiscalYear": 2025, "totalPay": 240