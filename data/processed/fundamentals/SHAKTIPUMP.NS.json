{"info": {"address1": "Plot No. 401, 402 & 413", "address2": "Sector - 3 Industrial Area Dhar District", "city": "Pithampur", "zip": "454774", "country": "India", "phone": "91 72 9241 0500", "fax": "91 72 9241 0645", "website": "https://www.shaktipumps.com", "industry": "Specialty Industrial Machinery", "industryKey": "specialty-industrial-machinery", "industryDisp": "Specialty Industrial Machinery", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Shakti Pumps (India) Limited, together with its subsidiaries, engages in the manufacture, trade, and sale of pumps, motors, and their spare parts under the Shakti brand name in India and internationally. Its products include submersible, solar, vertical multistage centrifugal, monoblock end suction, pressure booster, wastewater, open well, shallow well and slow speed, immersible, solar open well, single shaft vertical multistage, plug and play, vertical multistage, mechanical seal, horizontal openwell, sewage, self-priming, and rapid suction pumps, as well as submersible, surface, and slip start synchronous motors. The company also provides positive displacement submersible, inverter submersible, micro surface, and firefighting pumpsets, as well as hydropneumatic booster system; and solar pump and hybrid controllers, solar and universal drives, starters, hybrid and grid tie inverters, RMS/IoT dongles, DU/DT filters, electronic and control plants, mechanical seals, and solar structures. In addition, the company engages in the manufacture and sale of EV motors, controllers, chargers, and variable frequency drives for two- and three-wheeler vehicles; and solar DCR cell and solar PV modules. The company's products are used for agriculture, irrigation, waste and sewage water treatments, firefighting, building services, oil and gas, power, metals, mining, and other industrial applications. It also exports its products. Shakti Pumps (India) Limited was incorporated in 1982 and is headquartered in Pithampur, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Dinesh  Patidar", "age": 63, "title": "Chairman & Whole-Time Director", "yearBorn": 1962, "fiscalYear": 2025, "totalPay": 90000000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ramesh  Patidar", "age": 52, "title": "MD & Director", "yearBorn": 1973, "fiscalYear": 2025, "totalPay": 7500000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Dinesh  Patel", "title": "Chief Financial Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ravi  Patidar", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sunil Manoharlal Patidar", "age": 56, "title": "Whole Time Director", "yearBorn": 1969, "fiscalYear": 2025, "totalPay": 1200000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ashwin  Bhootda", "age": 41, "title": "Whole Time Director", "yearBorn": 1984, "fiscalYear": 2025, "totalPay": 2800000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Prof. Bal Mukund Sharma", "age": 72, "title": "Overall Head of Operations & HR", "yearBorn": 1953, "fiscalYear": 2025, "totalPay": 20000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ankit  Patidar", "title": "Deputy General Manager of Marketing", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. B. R. Patidar", "title": "Finance Controller", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 505.0, "open": 508.25, "dayLow": 508.25, "dayHigh": 515.45, "regularMarketPreviousClose": 505.0, "regularMarketOpen": 508.25, "regularMarketDayLow": 508.25, "regularMarketDayHigh": 515.45, "dividendRate": 1.0, "dividendYield": 0.2, "e