{"info": {"address1": "One Avante", "address2": "Level 7 to 12 Karve Road Kothrud", "city": "Pune", "zip": "411038", "country": "India", "phone": "91 20 2581 0341", "website": "https://kirloskaroilengines.com", "industry": "Specialty Industrial Machinery", "industryKey": "specialty-industrial-machinery", "industryDisp": "Specialty Industrial Machinery", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Kirloskar Oil Engines Limited manufactures and distributes diesel engines, agricultural pump sets, electric pump sets, power tillers, generating sets, and spares in India and internationally. It operates in three segments: Business to Business, Business to Customer, and Financial Services. The company offers power generation solutions, such as gensets, backup solutions, generator electrical, retrofit emission control device, and dual fuel kit for residential gensets, telecom, infrastructure, realty, hospitality, banks, defense, retail, healthcare, manufacturing, and data center; and industrial engines for excavation, construction, railways, mining, agriculture, fishery, defense, oil and gas, and fluid handling sectors. It also provides farm mechanization products, such as power tillers and weeders, rotary tillers, hand held tools, and allied products for agriculture sector; and water management solutions, such as diesel engines, electric and engine-based pumps, and alternators for retail, agriculture, and industrial sectors. In addition, the company offers annual maintenance contracts, spares, allied products, and after sales support services to customer support and service and retail channel sectors; and electric motors, organic waste, and firefighting solutions. Further, it provides financial services. The company was formerly known as Kirloskar Engines India Limited and changed its name to Kirloskar Oil Engines Limited in March 2010. Kirloskar Oil Engines Limited was founded in 1946 and is headquartered in Pune, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Sachin  Kejriwal", "age": 46, "title": "Chief Financial Officer", "yearBorn": 1979, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rahul  Sahai", "title": "Chief Executive Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Farah  Irani", "age": 42, "title": "Company Secretary & Compliance Officer", "yearBorn": 1983, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Kiran  Khapre", "title": "Chief Human Resources Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. M. N. Kumar", "age": 60, "title": "Head of Corporate Research Engineering", "yearBorn": 1965, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Shrikant  Pataskar", "title": "Head of International Business", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. T.  Parthasarathy Ph.D.", "age": 61, "title": "Vice President of Corp Quality", "yearBorn": 1964, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ankur  Gupta", "title": "Associate Vice President", "exercisedValue": 0, "unexercisedValue": 0}], "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 1671.0, "open": 1665.0, "dayLow": 1656.3, "dayHigh": 1717.0, "regularMarketPreviousClose": 1671.0, "regularMarketOpen": 1665.0, "regularMarketDayLow": 1656.3, "regularMarketDayHigh": 1717.0, "dividendRate": 6.5, "dividendYield": 0.39, "exDividendDate": 1771545600, "payoutRatio": 0.1665, "fiveYearAvgDividendYield": 1.14, "beta": 0.716, "trailingPE": 43.511513, "forwardPE": 30.380358, "volume": 182847, "regularMarketVolume": 182847, "averageVolume": 424939, "averageVolume10days": 497469, "averageDailyVolume10Day": 497469, "bid": 1701.9, "ask": 1702.5, "bidSize": 0, "askSize": 0, "marketCap": 247334895616, "nonDilutedMarketCap": 242929886424, "fiftyTwoWeekLow": 825.6, "fiftyTwoWeekHigh": 1775.0, "allTimeHigh": 1775.0, "al