{"info": {"address1": "PO Kanchanbagh", "city": "Hyderabad", "zip": "500058", "country": "India", "phone": "91 40 2418 4515", "fax": "91 40 2956 8502", "website": "https://www.midhani-india.in", "industry": "Steel", "industryKey": "steel", "industryDisp": "Steel", "sector": "Basic Materials", "sectorKey": "basic-materials", "sectorDisp": "Basic Materials", "longBusinessSummary": "Mishra Dhatu Nigam Limited manufactures and sells super alloys, titanium, special purpose steel, and other special metals in India and internationally. The company provides special steels, including martensitic, special, austenitic, and precipitation hardening steels for use in aerospace, power generation, nuclear, defence, cryogenic, and other general engineering industries. It also offers nickel, cobalt, and iron-based superalloys; titanium and titanium alloys, soft magnetic, controlled expansion alloys; investment castings products; bars, bright bars, and wires/fine wires; and hot and cold rolled sheets, and strips, as well as open die forging products. In addition, the company offers welding consumables, fasteners, biomedical implants, and armour products. Mishra Dhatu Nigam Limited was incorporated in 1973 and is based in Hyderabad, India.", "fullTimeEmployees": 786, "companyOfficers": [{"maxAge": 1, "name": "Mr. Paul  Antony", "title": "Company Secretary & Compliance Officer", "fiscalYear": 2025, "totalPay": 2129000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. S.V.S. Narayana Murty", "age": 56, "title": "Chairman & MD", "yearBorn": 1969, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Madhubala  Kalluri", "age": 58, "title": "CFO, Director of Finance & Director", "yearBorn": 1967, "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Padavittan  Babu", "title": "Director of Production & Marketing", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, 