{"info": {"address1": "Unit No 201 (i), (ii), (iiiA), (XVI)", "address2": "2nd Floor BPTP Park Centra Sector-30, NH-8", "city": "Gurugram", "zip": "122001", "country": "India", "phone": "91 12 4477 9200", "website": "https://www.hindwarehomes.com", "industry": "Furnishings, Fixtures & Appliances", "industryKey": "furnishings-fixtures-appliances", "industryDisp": "Furnishings, Fixtures & Appliances", "sector": "Consumer Cyclical", "sectorKey": "consumer-cyclical", "sectorDisp": "Consumer Cyclical", "longBusinessSummary": "Hindware Home Innovation Limited engages in the manufacturing, selling and trading of building products, consumer appliances in India. The company offers kitchen appliances comprising chimneys, cooking range, food waste disposers, cooktops, dishwashers, kitchen sinks, water purifiers, built-in microwaves, and ovens and hobs; storage, instant, gas, heat pump water heaters; desert, personal, and window air coolers, as well as ceiling and pedestal fans. It also provides building products consisting of sanitary ware, including water closets, wash basins, squatting pans, and urinals; faucets, such as bathroom, kitchen, and sensor faucets, diverters, showers, and thermostats; wellness products comprising bath-tub, shower enclosures, massage tubs, and steam generators; glazed vitrified, ceramic, vitrified, adhesives tiles; plastic pipes and fittings, which include CPVC, UPVC, PVC, SWR, column, and multi-layer composite pipe, as well as overhead water storage tanks and bath fittings; and allied products, such as concealed cisterns, seat covers, PVC cisterns, and bidet attachments. The company offers its products under Hindware, Hindware Italian Collection, Queo, Truflo by Hindware, Hindware Smart Appliances, Hindware Atlantic, and FGV By Hindware brand name. The company was formerly known as Somany Home Innovation Limited and changed its name to Hindware Home Innovation Limited in May 2022. Hindware Home Innovation Limited was incorporated in 2017 and is based in Gurugram, India.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Nirupam  Sahay MMS", "age": 52, "title": "Chief Executive Officer", "yearBorn": 1973, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Naveen  Malik", "title": "Chief Financial Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Payal M. Puri", "title": "Company Secretary, Senior VP, Group General Counsel & Compliance Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Arunima  Yadav", "title": "VP & Head of Marketing", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sandeep  Sikka", "title": "Group Chief Financial Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Rajesh  Pajnoo BE, DBM, PGDM&SM", "age": 58, "title": "Chief Executive Officer of Pipe Business", "yearBorn": 1967, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Nitesh  Raj", "title": "Head of Commercial Business", "exercisedValue": 0, "unexercisedValue": 0}], "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 242.99, "open": 242.99, "dayLow": 240.32, "dayHigh": 247.8, "regularMarketPreviousClose": 242.99, "regularMarketOpen": 242.99, "regularMarketDayLow": 240.32, "regularMarketDayHigh": 247.8, "exDividendDate": 1724284800, "payoutRatio": 0.0, "beta": 0.362, "forwardPE": 14.659574, "volume": 39478, "regularMarketVolume": 39478, "averageVolume": 199831, "averageVolume10days": 149105, "averageDailyVolume10Day": 149105, "bid": 240.96, "ask": 241.74, "marketCap": 20171319296, "nonDilutedMarketCap": 20388799518, "fiftyTwoWeekLow": 170.5, "fiftyTwoWeekHigh": 392.7, "allTimeHigh": 664.1, "allTimeLow": 53.55, "priceToSalesTrailing12Months": 0.79251456, "fiftyDayAverage": 210.2318, "twoHundredDayAverage": 273.98935, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "INR", "tradeable": false, "enterpriseValue": 28641683456, "pro